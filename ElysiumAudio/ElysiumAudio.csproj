<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
	  <ApplicationIcon>Assets\elysium.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Sin símbolos en Release: el ejecutable distribuible no los necesita. En Debug
       se dejan intactos para poder depurar paso a paso. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- Los paquetes nativos de SkiaSharp y HarfBuzzSharp meten sus .pdb dentro de
       runtimes/<rid>/native/, y el SDK los copia al publicar sin distinguirlos del
       resto de assets. Son ~100 MB de símbolos que no aportan nada en una release. -->
  <Target Name="StripPublishDebugSymbols" AfterTargets="Publish">
    <ItemGroup>
      <_PdbToStrip Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PdbToStrip)" />
    <Message Importance="high" Text="StripPublishDebugSymbols: eliminados @(_PdbToStrip->Count()) .pdb" />
  </Target>

  <!-- Información del producto: la lee Services.AppInfo para el modal de Ajustes. -->
  <PropertyGroup>
    <Product>Elysium Audio</Product>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>Simplan</Company>
    <Authors>Juan Esteban V.</Authors>
    <Copyright>Copyright © 2026 Simplan</Copyright>
    <StartupObject>ElysiumAudio.Program</StartupObject>
    <AssemblyTitle></AssemblyTitle>
    <AssemblyName></AssemblyName>
  </PropertyGroup>

  <!-- <Authors> solo afecta al paquete NuGet; esto lo publica como atributo de
       ensamblado para que Services.AppInfo pueda leerlo. -->
  <ItemGroup>
    <AssemblyMetadata Include="Author" Value="Juan Esteban V." />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="NAudio" Version="3.0.1" />
    <PackageReference Include="NAudio.SoundFile" Version="3.0.1" />
    <PackageReference Include="org.sndfile.runtime.win-x64" Version="1.2.2" />
    <PackageReference Include="Projektanker.Icons.Avalonia" Version="9.6.2" />
    <PackageReference Include="Projektanker.Icons.Avalonia.FontAwesome" Version="9.6.2" />
    <PackageReference Include="z440.atl.core" Version="7.16.0" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Remove="Assets\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\icon.ico" />
  </ItemGroup>
</Project>
