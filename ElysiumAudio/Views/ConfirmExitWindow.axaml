<Window
    x:Class="ElysiumAudio.Views.ConfirmExitWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:ElysiumAudio.Localization"
    Title="Cerrar Elysium Audio"
    Width="450"
    Height="210"
    MinWidth="400"
    MinHeight="190"
    Background="{StaticResource BrushBgPanel}"
    CanResize="False"
    Foreground="{StaticResource BrushTextPrimary}"
    Topmost="True"
    WindowStartupLocation="CenterOwner">

    <Border
        Background="{StaticResource BrushBgPanel}"
        BorderBrush="{StaticResource BrushBorderDefault}"
        BorderThickness="1"
        CornerRadius="12">
        <StackPanel Margin="26,22,26,22" Spacing="12">
            <TextBlock
                FontSize="{StaticResource FontSizeDisplay}"
                FontWeight="SemiBold"
                Foreground="{StaticResource BrushTextPrimary}"
                Text="{l10n:Localize ConfirmExitTitle}" />

            <TextBlock
                FontSize="{StaticResource FontSizeBase}"
                Foreground="{StaticResource BrushTextSecondary}"
                LineHeight="20"
                MaxLines="2"
                Text="{l10n:Localize ConfirmExitMessage}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />

            <StackPanel
                Margin="0,12,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="10">
                <Button
                    Classes="ghost"
                    Click="OnContinueClick"
                    Content="{l10n:Localize ContinueProcessing}" />
                <Button
                    Classes="main"
                    Click="OnExitClick"
                    Content="{l10n:Localize CancelAndExit}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>