<Window
    x:Class="ElysiumAudio.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Avalonia.Controls"
    xmlns:conv="using:ElysiumAudio.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:netDataGrid="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
    xmlns:vm="using:ElysiumAudio.ViewModels"
    Title="Elysium Audio"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:MainWindowViewModel"
    Background="#121212"
    Foreground="#E4E4E7"
    Icon="/Assets/avalonia-logo.ico"
    mc:Ignorable="d">

    <Design.DataContext>
        <!--
            This only sets the DataContext for the previewer in an IDE,
            to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs)
        -->
        <vm:MainWindowViewModel />
    </Design.DataContext>
    <Window.Resources>
        <conv:LufsRangeConverter x:Key="LufsRangeConverter" />
    </Window.Resources>

    <Grid Margin="16" RowDefinitions="Auto, *, Auto, Auto">

        <!--  Panel Superior: Controles y Título  -->
        <Grid
            Grid.Row="0"
            Margin="0,0,0,12"
            ColumnDefinitions="*, Auto">
            <StackPanel Grid.Column="0">
                <TextBlock
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="White"
                    LetterSpacing="2"
                    Text="ELYSIUM AUDIO" />
                <TextBlock
                    Margin="0,2,0,12"
                    FontSize="12"
                    Foreground="#A1A1AA"
                    Text="Pure linear normalizer designed for high dynamic range music &amp; ballads." />
            </StackPanel>

            <!--  Botones de Acción Rápida  -->
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <Button
                    Padding="14,8"
                    Background="#2563EB"
                    Command="{Binding AddFileCommand}"
                    FontWeight="SemiBold"
                    Foreground="White">
                    📁 Add Files
                </Button>
                <Button
                    Padding="14,8"
                    Background="#27272A"
                    Command="{Binding ClearListCommand}"
                    Foreground="#E4E4E7">
                    Clear List
                </Button>
            </StackPanel>
        </Grid>

        <!--  Zona Central: Cola de Archivos (DataGrid)  -->
        <Border
            Name="DropZoneBorder"
            Grid.Row="1"
            Margin="0,8,0,0"
            Padding="4"
            Background="#18181B"
            BorderBrush="#27272A"
            BorderThickness="1"
            CornerRadius="8"
            DragDrop.AllowDrop="True">

            <DataGrid
                AutoGenerateColumns="False"
                Background="Transparent"
                BorderThickness="0"
                CanUserReorderColumns="True"
                CanUserResizeColumns="True"
                GridLinesVisibility="Horizontal"
                IsReadOnly="True"
                ItemsSource="{Binding AudioFiles}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="110"
                        Binding="{Binding Status}"
                        Header="Status" />
                    <DataGridTextColumn
                        Width="280"
                        Binding="{Binding FileName}"
                        Header="File Name" />
                    <DataGridTextColumn
                        Width="80"
                        Binding="{Binding Codec}"
                        Header="Codec" />
                    <DataGridTextColumn
                        Width="98"
                        Binding="{Binding Duration}"
                        Header="Duration" />

                    <!--  Valores del archivo original  -->
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding Loudness}"
                        Header="Original LUFS" />
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding Peak}"
                        Header="Original Peak" />

                    <!--  Valores del archivo normalizado  -->
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding NormalizedLoudness}"
                        Header="Normalized LUFS" />
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding NormalizedPeak}"
                        Header="Normalized Peak" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!--  Panel Inferior: Ajustes Técnicos de Audio  -->
        <Grid
            Grid.Row="2"
            Margin="0,16,0,0"
            ColumnDefinitions="*, *"
            ColumnSpacing="16">

            <!--  Panel Izquierdo: Configuración de Volumen y Techos  -->
            <Border
                Grid.Column="0"
                Padding="20"
                Background="#18181B"
                BorderBrush="#27272A"
                BorderThickness="1"
                CornerRadius="10"
                Focusable="True">

                <StackPanel Spacing="20">
                    <!--  Encabezado  -->
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="⚙️ DSP y Loudness Calibration" />

                    <!--  Sección Target Loudness  -->
                    <StackPanel Margin="24,0,8,0" Spacing="1">
                        <TextBlock
                            FontSize="13"
                            FontWeight="Medium"
                            Foreground="#A1A1AA"
                            Text="Target Loudness (LUFS)" />

                        <Grid VerticalAlignment="Center" ColumnDefinitions="*,18,Auto">
                            <!--  Slider  -->
                            <Grid ColumnDefinitions="26,2, *,2 , 26">
                                <TextBlock
                                    Grid.Column="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="#A1A1AA"
                                    Text="-24" />
                                <Slider
                                    Grid.Column="2"
                                    Foreground="#2563EB"
                                    IsSnapToTickEnabled="True"
                                    Maximum="-6"
                                    Minimum="-24"
                                    TickFrequency="0.1"
                                    Value="{Binding TargetLufs}" />
                                <TextBlock
                                    Grid.Column="4"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="#A1A1AA"
                                    Text="-6" />
                            </Grid>


                            <!--  Caja de valor  -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <TextBox
                                    Width="42"
                                    Height="26"
                                    MinWidth="42"
                                    Padding="1,2"
                                    VerticalContentAlignment="Center"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="4"
                                    FontSize="13"
                                    Foreground="#319CD7"
                                    KeyDown="OnTextBoxKeyDown"
                                    LostFocus="OnTextBoxLostFocus"
                                    Text="{Binding TargetLufs, Mode=OneWay, StringFormat=F1}"
                                    TextAlignment="Center" />

                                <TextBlock
                                    Margin="1,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#E4E4E7"
                                    Text="LUFS" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!--  Sección True Peak Ceiling  -->
                    <StackPanel Margin="24,0,8,0" Spacing="1">
                        <TextBlock
                            FontSize="13"
                            FontWeight="Medium"
                            Foreground="#A1A1AA"
                            Text="True Peak Ceiling Threshold" />

                        <Grid VerticalAlignment="Center" ColumnDefinitions="*,18,Auto">
                            <!--  Slider para True Peak  -->
                            <Grid ColumnDefinitions="26,2, *,2 , 26">
                                <TextBlock
                                    Grid.Column="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="#A1A1AA"
                                    Text="-3" />
                                <Slider
                                    Grid.Column="2"
                                    IsSnapToTickEnabled="True"
                                    Maximum="-0.1"
                                    Minimum="-3.0"
                                    TickFrequency="0.1"
                                    Value="{Binding TruePeakCeiling}" />
                                <TextBlock
                                    Grid.Column="4"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="#A1A1AA"
                                    Text="-0.1" />
                            </Grid>

                            <StackPanel
                                Grid.Column="2"
                                HorizontalAlignment="Left"
                                Orientation="Horizontal">
                                <TextBox
                                    Width="42"
                                    Height="26"
                                    MinWidth="42"
                                    Padding="1,2"
                                    VerticalContentAlignment="Center"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="4"
                                    FontSize="13"
                                    Foreground="#32ADD6"
                                    KeyDown="OnTruePeakKeyDown"
                                    LostFocus="OnTruePeakLostFocus"
                                    Text="{Binding TruePeakCeilingString, Mode=OneWay, StringFormat=F1}"
                                    TextAlignment="Center" />
                                <TextBlock
                                    Margin="1,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#E4E4E7"
                                    Text="dBTP" />
                            </StackPanel>
                        </Grid>

                    </StackPanel>

					<!--  Sección Release Time (Nuevo) -->
					<StackPanel Margin="24,0,8,0" Spacing="1">
						<TextBlock
							FontSize="13"
							FontWeight="Medium"
							Foreground="#A1A1AA"
							Text="Release Time (Tiempo de Liberación)" />

						<Grid VerticalAlignment="Center" ColumnDefinitions="*,18,Auto">
							<Grid ColumnDefinitions="26,2, *,2 , 26">
								<TextBlock Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="#A1A1AA" Text="5" />
								<!--<Slider Grid.Column="2" Foreground="#D97706" IsSnapToTickEnabled="True" Maximum="500" Minimum="5" TickFrequency="1" Value="{Binding ReleaseMs}" />-->
								<TextBlock Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="#A1A1AA" Text="500" />
							</Grid>

							<StackPanel Grid.Column="2" Orientation="Horizontal">
								<TextBox
									Name="ReleaseInput"
									Width="42" Height="26" MinWidth="42" Padding="1,2" VerticalContentAlignment="Center"
									Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="4"
									FontSize="13" Foreground="#F59E0B" KeyDown="OnReleaseKeyDown" LostFocus="OnReleaseLostFocus"
									Text="{Binding ReleaseMsText, Mode=OneWay}" TextAlignment="Center" />
								<TextBlock Margin="1,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="#E4E4E7" Text="ms" />
							</StackPanel>
						</Grid>
					</StackPanel>

					<!--  Sección Look-ahead Time (Nuevo) -->
					<StackPanel Margin="24,0,8,0" Spacing="1">
						<TextBlock
							FontSize="13"
							FontWeight="Medium"
							Foreground="#A1A1AA"
							Text="Look-ahead Time (Tiempo de Avance)" />

						<Grid VerticalAlignment="Center" ColumnDefinitions="*,18,Auto">
							<Grid ColumnDefinitions="26,2, *,2 , 26">
								<TextBlock Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="#A1A1AA" Text="0" />
								<!--<Slider Grid.Column="2" Foreground="#10B981" IsSnapToTickEnabled="True" Maximum="15" Minimum="0" TickFrequency="0.1" Value="{Binding LookAheadMs}" />-->
								<TextBlock Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="#A1A1AA" Text="15" />
							</Grid>

							<StackPanel Grid.Column="2" Orientation="Horizontal">
								<TextBox
									Name="LookAheadInput"
									Width="42" Height="26" MinWidth="42" Padding="1,2" VerticalContentAlignment="Center"
									Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="4"
									FontSize="13" Foreground="#10B981" KeyDown="OnLookAheadKeyDown" LostFocus="OnLookAheadLostFocus"
									Text="{Binding LookAheadMsText, Mode=OneWay, StringFormat=F1}" TextAlignment="Center" />
								<TextBlock Margin="1,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="#E4E4E7" Text="ms" />
							</StackPanel>
						</Grid>
					</StackPanel>

				</StackPanel>
            </Border>



            <!--  Panel Derecho: Ajustes del Limitador Soft-Limiter y Ejecución  -->
            <Border
                Grid.Column="1"
                Padding="16"
                Background="#18181B"
                BorderBrush="#27272A"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowDefinitions="*, Auto">
                    <StackPanel Grid.Row="0" Spacing="12">
                        <TextBlock
                            FontWeight="Bold"
                            Foreground="White"
                            Text="Mastering Execution &amp; Safety" />

                        <CheckBox
                            Content="Strict Linear Mode (Protects Ballad Micro-dynamics)"
                            Foreground="#E4E4E7"
                            IsChecked="{Binding IsStrictLinearMode}" />

                        <!--  Casilla para forzar ID3v2.3 en WAV y mantener carátulas  -->
                        <CheckBox
                            Content="Preserve Metadata &amp; Injected Cover Art (ID3v2.3)"
                            Foreground="#E4E4E7"
                            IsChecked="True" />
                    </StackPanel>

                    <!--  Botón de Ejecución Principal  -->
                    <Button
                        Grid.Row="1"
                        Padding="12"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Background="#059669"
                        Command="{Binding StartNormalizationCommand}"
                        FontWeight="Bold"
                        Foreground="White">
                        ▶ Run Batch Normalization
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!--  Barra de Estado Global  -->
        <Border
            Grid.Row="3"
            Margin="0,14,0,0"
            Padding="8,4"
            Background="#18181B"
            CornerRadius="4">
            <TextBlock
                VerticalAlignment="Center"
                FontFamily="Consolas,Monospace"
                FontSize="11"
                Foreground="#34D399"
                Text="{Binding SystemStatus}" />
        </Border>
    </Grid>
</Window>
