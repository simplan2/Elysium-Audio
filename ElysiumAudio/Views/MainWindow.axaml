<Window
    x:Class="ElysiumAudio.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Avalonia.Controls"
    xmlns:conv="using:ElysiumAudio.Converters"
    xmlns:customControls="using:ElysiumAudio.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ElysiumAudio.Models"
    xmlns:netDataGrid="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
    xmlns:vm="using:ElysiumAudio.ViewModels"
    Title="Elysium Audio"
    Width="1080"
    Height="700"
    d:DesignHeight="540"
    d:DesignWidth="800"
    x:DataType="vm:MainWindowViewModel"
    Background="#121212"
    Foreground="#E4E4E7"
    Icon="/Assets/avalonia-logo.ico"
    mc:Ignorable="d">

    <Design.DataContext>
        <!--
            This only sets the DataContext for the previewer in an IDE,
            to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs)
        -->
        <vm:MainWindowViewModel />
    </Design.DataContext>
    <Window.Resources>
        <conv:DynamicNumberFormatConverter x:Key="DynamicNumberFormatConverter" />
    </Window.Resources>

    <Grid Margin="16" RowDefinitions="Auto, *, Auto, Auto">

        <!--  Panel Superior: Controles y Título  -->
        <Grid
            Grid.Row="0"
            Margin="0,0,0,12"
            ColumnDefinitions="*, Auto">
            <StackPanel Grid.Column="0">
                <TextBlock
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="White"
                    LetterSpacing="2"
                    Text="ELYSIUM AUDIO" />
                <TextBlock
                    Margin="0,2,0,12"
                    FontSize="12"
                    Foreground="#A1A1AA"
                    Text="Pure linear normalizer designed for high dynamic range music &amp; ballads." />
            </StackPanel>

            <!--  Botones de Acción Rápida  -->
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <Button
                    Padding="14,8"
                    Background="#2563EB"
                    Command="{Binding AddFileCommand}"
                    FontWeight="SemiBold"
                    Foreground="White">
                    📁 Add Files
                </Button>
                <Button
                    Padding="14,8"
                    Background="#334155"
                    Command="{Binding SelectOutputDirectoryCommand}"
                    Foreground="#E4E4E7">
                    📂 Output Dir
                </Button>
                <Button
                    Padding="14,8"
                    Background="#27272A"
                    Command="{Binding ClearListCommand}"
                    Foreground="#D5D5D9">
                    🗑️ Clear List
                </Button>

            </StackPanel>
        </Grid>

        <!--  Zona Central: Cola de Archivos (DataGrid)  -->
        <Border
            Name="DropZoneBorder"
            Grid.Row="1"
            Margin="0,8,0,0"
            Padding="4"
            Background="#18181B"
            BorderBrush="#27272A"
            BorderThickness="1"
            CornerRadius="8"
            DragDrop.AllowDrop="True">

            <DataGrid
                AutoGenerateColumns="False"
                Background="Transparent"
                BorderThickness="0"
                CanUserReorderColumns="True"
                CanUserResizeColumns="True"
                GridLinesVisibility="Horizontal"
                IsReadOnly="True"
                ItemsSource="{Binding AudioFiles}"
                RowHeight="40">
                <DataGrid.Styles>
                    <Style Selector="TextBlock">
                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        <Setter Property="TextWrapping" Value="NoWrap" />
                    </Style>
                </DataGrid.Styles>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="88" Header="Status">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:AudioFileModel">
                                <customControls:AudioStatusIndicator
                                    Width="32"
                                    Height="32"
                                    HorizontalAlignment="Center"
                                    Status="{Binding Status}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        Width="270"
                        Binding="{Binding FileName}"
                        Header="File Name" />
                    <DataGridTextColumn
                        Width="80"
                        Binding="{Binding Codec}"
                        Header="Codec" />
                    <DataGridTextColumn
                        Width="98"
                        Binding="{Binding Duration}"
                        Header="Duration" />

                    <!--  Valores del archivo original  -->
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding Loudness}"
                        Header="Original LUFS" />
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding Peak}"
                        Header="Original Peak" />

                    <!--  Valores del archivo normalizado  -->
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding NormalizedLoudness}"
                        Header="Normalized LUFS" />
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding NormalizedPeak}"
                        Header="Normalized Peak" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!--  Panel Inferior: Ajustes Técnicos de Audio  -->
        <Grid
            Grid.Row="2"
            Margin="0,16,0,0"
            ColumnDefinitions="*, *"
            ColumnSpacing="16">

            <!--  Panel Izquierdo: Configuración de Volumen y Techos  -->
            <Border
                Grid.Column="0"
                Padding="20"
                Background="#18181B"
                BorderBrush="#27272A"
                BorderThickness="1"
                CornerRadius="10"
                Focusable="True">

                <StackPanel Spacing="4">
                    <!--  Encabezado  -->
                    <TextBlock
                        Margin="0,0,0,16"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="⚙️ DSP y Loudness Calibration" />

                    <!--  1. Sección Target Loudness  -->
                    <StackPanel Margin="24,0,10,0">
                        <TextBlock
                            FontSize="13"
                            FontWeight="Medium"
                            Foreground="#A1A1AA"
                            Text="Target Loudness (LUFS)" />

                        <Grid VerticalAlignment="Center" ColumnDefinitions="*,64,88">
                            <!--  Slider  -->
                            <Grid ColumnDefinitions="28, 2, *, 2, 28">
                                <TextBlock
                                    Grid.Column="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="#A1A1AA"
                                    Text="{Binding MinTargetLufs, Converter={StaticResource DynamicNumberFormatConverter}}" />
                                <Slider
                                    Grid.Column="2"
                                    Foreground="#2563EB"
                                    Maximum="-6.0"
                                    Minimum="-24.0"
                                    Value="{Binding TargetLufs}" />
                                <TextBlock
                                    Grid.Column="4"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="#A1A1AA"
                                    Text="{Binding MaxTargetLufs, Converter={StaticResource DynamicNumberFormatConverter}}" />
                            </Grid>

                            <!--  Caja de valor  -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <TextBox
                                    Width="42"
                                    Height="26"
                                    MinWidth="42"
                                    Padding="1,0"
                                    VerticalContentAlignment="Center"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="4"
                                    FontSize="13"
                                    Foreground="#319CD7"
                                    KeyDown="OnTargetLufsKeyDown"
                                    LostFocus="OnTargetLufsLostFocus"
                                    Text="{Binding TargetLufs, Mode=OneWay, Converter={StaticResource DynamicNumberFormatConverter}}"
                                    TextAlignment="Center" />

                                <TextBlock
                                    Margin="1,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#E4E4E7"
                                    Text="LUFS" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!--  2. Sección True Peak Ceiling  -->
                    <StackPanel Margin="24,0,10,0">
                        <TextBlock
                            FontSize="13"
                            FontWeight="Medium"
                            Foreground="#A1A1AA"
                            Text="True Peak Ceiling Threshold" />

                        <Grid VerticalAlignment="Center" ColumnDefinitions="*,64,88">
                            <!--  Slider para True Peak  -->
                            <Grid ColumnDefinitions="28, 2, *, 2, 28">
                                <TextBlock
                                    Grid.Column="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="#A1A1AA"
                                    Text="{Binding MinPeakCeiling, Converter={StaticResource DynamicNumberFormatConverter}}" />
                                <Slider
                                    Grid.Column="2"
                                    Maximum="-0.1"
                                    Minimum="-3.0"
                                    Value="{Binding TruePeakCeiling}" />
                                <TextBlock
                                    Grid.Column="4"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="#A1A1AA"
                                    Text="{Binding MaxPeakCeiling, Converter={StaticResource DynamicNumberFormatConverter}}" />
                            </Grid>

                            <StackPanel
                                Grid.Column="2"
                                HorizontalAlignment="Left"
                                Orientation="Horizontal">
                                <TextBox
                                    Width="42"
                                    Height="26"
                                    MinWidth="42"
                                    Padding="1,0"
                                    VerticalContentAlignment="Center"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="4"
                                    FontSize="13"
                                    Foreground="#32ADD6"
                                    KeyDown="OnTruePeakKeyDown"
                                    LostFocus="OnTruePeakLostFocus"
                                    Text="{Binding TruePeakCeilingString, Mode=OneWay, Converter={StaticResource DynamicNumberFormatConverter}}"
                                    TextAlignment="Center" />
                                <TextBlock
                                    Margin="1,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#E4E4E7"
                                    Text="dBTP" />
                            </StackPanel>
                        </Grid>

                    </StackPanel>

                    <!--  3 Sección Release Time (Nuevo)  -->
                    <StackPanel Margin="24,0,10,0">
                        <TextBlock
                            FontSize="13"
                            FontWeight="Medium"
                            Foreground="#A1A1AA"
                            Text="Release Time (Tiempo de Liberación)" />

                        <Grid VerticalAlignment="Center" ColumnDefinitions="*,64,88">
                            <Grid ColumnDefinitions="28, 2, *, 2, 28">
                                <TextBlock
                                    Grid.Column="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="#A1A1AA"
                                    Text="5" />
                                <Slider
                                    Grid.Column="2"
                                    Foreground="#D97706"
                                    IsSnapToTickEnabled="True"
                                    Maximum="500"
                                    Minimum="5"
                                    TickFrequency="1" />
                                <TextBlock
                                    Grid.Column="4"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="#A1A1AA"
                                    Text="500" />
                            </Grid>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <TextBox
                                    Name="ReleaseTimeMsInput"
                                    Width="42"
                                    Height="26"
                                    MinWidth="42"
                                    Padding="1,0"
                                    VerticalContentAlignment="Center"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="4"
                                    FontSize="13"
                                    Foreground="#F59E0B"
                                    KeyDown="OnReleaseTimeMsKeyDown"
                                    LostFocus="OnReleaseTimeMsLostFocus"
                                    Text="{Binding ReleaseTimeMsText, Mode=TwoWay, Converter={StaticResource DynamicNumberFormatConverter}}"
                                    TextAlignment="Center" />
                                <TextBlock
                                    Margin="1,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#E4E4E7"
                                    Text="ms" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!--  4. Sección Look-ahead Time (Nuevo)  -->
                    <StackPanel Margin="24,0,10,0">
                        <TextBlock
                            FontSize="13"
                            FontWeight="Medium"
                            Foreground="#A1A1AA"
                            Text="Look-ahead Time (Tiempo de Avance)" />

                        <Grid VerticalAlignment="Center" ColumnDefinitions="*,64,88">
                            <Grid ColumnDefinitions="28, 2, *, 2, 28">
                                <TextBlock
                                    Grid.Column="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="#A1A1AA"
                                    Text="0" />
                                <Slider
                                    Grid.Column="2"
                                    Foreground="#10B981"
                                    IsSnapToTickEnabled="True"
                                    Maximum="15"
                                    Minimum="0"
                                    TickFrequency="0.1" />
                                <TextBlock
                                    Grid.Column="4"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="#A1A1AA"
                                    Text="15" />
                            </Grid>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <TextBox
                                    Name="LookAheadInput"
                                    Width="42"
                                    Height="26"
                                    MinWidth="42"
                                    Padding="1,0"
                                    VerticalContentAlignment="Center"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="4"
                                    FontSize="13"
                                    Foreground="#10B981"
                                    KeyDown="OnLookAheadKeyDown"
                                    LostFocus="OnLookAheadLostFocus"
                                    Text="{Binding LookAheadTimeMsText, Mode=TwoWay, Converter={StaticResource DynamicNumberFormatConverter}}"
                                    TextAlignment="Center" />
                                <TextBlock
                                    Margin="1,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#E4E4E7"
                                    Text="ms" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </Border>



            <!--  Panel Derecho: Ajustes del Limitador Soft-Limiter y Ejecución  -->
            <Border
                Grid.Column="1"
                Padding="16"
                Background="#18181B"
                BorderBrush="#27272A"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowDefinitions="*, Auto, Auto">
                    <StackPanel Grid.Row="0" Spacing="12">
                        <TextBlock
                            FontWeight="Bold"
                            Foreground="White"
                            Text="Mastering Execution &amp; Safety" />

                        <CheckBox
                            Content="Strict Linear Mode (Protects Ballad Micro-dynamics)"
                            Foreground="#E4E4E7"
                            IsChecked="{Binding IsStrictLinearMode}" />

                        <!--  Casilla para forzar ID3v2.3 en WAV y mantener carátulas  -->
                        <CheckBox
                            Content="Preserve Metadata &amp; Injected Cover Art (ID3v2.3)"
                            Foreground="#E4E4E7"
                            IsChecked="True" />
                    </StackPanel>

                    <!--  Botón de Ejecución Principal  -->
                    <Button
                        Grid.Row="1"
                        Padding="12"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Background="#059669"
                        Command="{Binding StartNormalizationCommand}"
                        FontWeight="Bold"
                        Foreground="White">
                        ▶ Run Batch Normalization
                    </Button>
                    <TextBlock
                        Grid.Row="2"
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center"
                        FontSize="10"
                        Foreground="#A1A1AA"
                        Text="{Binding OutputDirectory, StringFormat='Salida: {0}'}" />
                </Grid>
            </Border>
        </Grid>

        <!--  Barra de Estado Global  -->
        <Border
            Grid.Row="3"
            Margin="0,14,0,0"
            Padding="8,4"
            Background="#18181B"
            CornerRadius="4">
            <TextBlock
                VerticalAlignment="Center"
                FontFamily="Consolas,Monospace"
                FontSize="11"
                Foreground="#34D399"
                Text="{Binding SystemStatus}" />
        </Border>
    </Grid>
</Window>
