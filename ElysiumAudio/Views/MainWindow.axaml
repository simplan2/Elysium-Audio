                                                    <TextBlock
                                                        Grid.Column="3"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        FontSize="{StaticResource FontSizeXS}"
                                                        Foreground="{StaticResource BrushAccentSkyblue}"
                                                        Text="dBTP" />
                                                </Grid>

                                        -->
                                        <!--  Fila: Release Time  -->
                                        <!--
                                                <Grid
                                                    ColumnDefinitions="6,*,Auto,30"
                                                    ColumnSpacing="8">
                                                    <Ellipse
                                                        Width="5"
                                                        Height="5"
                                                        VerticalAlignment="Center"
                                                        Fill="{StaticResource BrushAccentRosa}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        FontSize="{StaticResource FontSizeSmall}"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource BrushTextSecondary}"
                                                        Text="{l10n:Localize ReleaseTime}" />
