                                                        TextAlignment="Center" />
                                                    <TextBlock
                                                        Grid.Column="3"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        FontSize="{StaticResource FontSizeXS}"
                                                        Foreground="{StaticResource BrushSuccess}"
                                                        Text="ms" />
                                                </Grid>

                                            </StackPanel>
                                        </Border>-->

                                    </StackPanel>
                                </Border>

                                <!--  1.2 Execution & Safety  -->
                                <Border
                                    Grid.Row="2"
                                    Padding="14"
                                    Background="{StaticResource BrushBgPanelAlt}"
                                    BorderBrush="{StaticResource BrushBorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <StackPanel IsVisible="{Binding IsNormalizeMode}" Spacing="12">

                                        <Grid VerticalAlignment="Center" ColumnDefinitions="Auto,9,*">
                                            <Ellipse
                                                Width="7"
                                                Height="7"
                                                Fill="{StaticResource BrushAccentSkyblue}" />
                                            <TextBlock
                                                Grid.Column="2"
                                                FontSize="{StaticResource FontSizeSmall}"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource BrushTextMuted}"
                                                Text="{l10n:Localize ExecutionSafety}" />
                                        </Grid>

                                        <!--  Preservar Metadatos (solo aplica al normalizar)  -->
                                        <CheckBox
                                            Content="{l10n:Localize PreserveMetadata}"
                                            Foreground="{StaticResource BrushTextSecondary}"
                                            IsChecked="{Binding PreserveMetadata}"
                                            IsEnabled="{Binding IsNormalizeMode}" />

                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!--  2. Panel de Análisis (modo Analizar)  -->
                            <StackPanel
                                Grid.Row="1"
                                IsVisible="{Binding IsAnalyzeMode}"
                                Spacing="12">

                                <!--  Encabezado: título + chip de lote  -->
                                <StackPanel
                                    Margin="4,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource FontSizeXL}"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource BrushAccentSkyblue}"
                                        Text="{l10n:Localize Analysis}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource FontSizeXL}"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource BrushTextPrimary}"
                                        Text="{l10n:Localize ReportSuffix}" />
                                </StackPanel>

                                <!--  1. Ficha del archivo seleccionado  -->
                                <Border
                                    Padding="14"
                                    Background="{StaticResource BrushBgPanelAlt}"
                                    BorderBrush="{StaticResource BrushBorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <StackPanel Spacing="10">
                                        <!--  Cabecera del card  -->
                                        <Grid VerticalAlignment="Center" ColumnDefinitions="Auto,6,*,Auto">
                                            <Ellipse
                                                Width="7"
                                                Height="7"
                                                VerticalAlignment="Center"
                                                Fill="{StaticResource BrushAccentSkyblue}" />
                                            <TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                FontSize="{StaticResource FontSizeSmall}"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource BrushTextMuted}"
                                                Text="{l10n:Localize SelectedFile}" />

                                            <!--
                                                Conmutador Original / Normalizado.
                                                Solo aparece si el archivo ya fue
                                                normalizado: antes de eso no hay un
                                                segundo juego de métricas que ver.
                                            -->

                                        </Grid>

                                        <StackPanel IsVisible="{Binding HasSelectedFile}" Spacing="10">
                                            <!--  Nombre del archivo  -->
                                            <TextBlock
                                                FontSize="{StaticResource FontSizeLG}"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource BrushTextPrimary}"
                                                Text="{Binding SelectedFile.FileName}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap"
                                                ToolTip.Tip="{Binding SelectedFile.FileName}" />

                                            <!--  Metadatos  -->
                                            <Grid
                                                ColumnDefinitions="*,12,*"
                                                IsVisible="{Binding HasSelectedFile}"
                                                RowDefinitions="Auto,Auto"
                                                RowSpacing="7">
                                                <Grid RowDefinitions="Auto,Auto" RowSpacing="7">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock
                                                            FontSize="{StaticResource FontSizeMedium}"
                                                            Foreground="{StaticResource BrushTextSecondary}"
                                                            Text="{l10n:Localize Format}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            FontSize="{StaticResource FontSizeMedium}"
                                                            FontWeight="SemiBold"
                                                            Foreground="{StaticResource BrushTextPrimary}"
                                                            Text="{Binding SelectedFile.Codec}" />
                                                    </Grid>
                                                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                                                        <TextBlock
                                                            FontSize="{StaticResource FontSizeMedium}"
                                                            Foreground="{StaticResource BrushTextSecondary}"
                                                            Text="{l10n:Localize SampleRate}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            FontSize="{StaticResource FontSizeMedium}"
                                                            FontWeight="SemiBold"
                                                            Foreground="{StaticResource BrushTextPrimary}"
                                                            Text="{Binding SelectedFileSampleRateText}" />
                                                    </Grid>
                                                </Grid>
                                                <Grid
                                                    Grid.Column="2"
                                                    RowDefinitions="Auto,Auto"
                                                    RowSpacing="7">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock
                                                            FontSize="{StaticResource FontSizeMedium}"
                                                            Foreground="{StaticResource BrushTextSecondary}"
                                                            Text="{l10n:Localize Duration}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            FontSize="{StaticResource FontSizeMedium}"
                                                            FontWeight="SemiBold"
                                                            Foreground="{StaticResource BrushTextPrimary}"
                                                            Text="{Binding SelectedFile.Duration}" />
                                                    </Grid>
                                                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                                                        <TextBlock
                                                            FontSize="{StaticResource FontSizeMedium}"
                                                            Foreground="{StaticResource BrushTextSecondary}"
                                                            Text="{l10n:Localize Channels}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            FontSize="{StaticResource FontSizeMedium}"
                                                            FontWeight="SemiBold"
                                                            Foreground="{StaticResource BrushTextPrimary}"
                                                            Text="{Binding SelectedFileChannelsText}" />
                                                    </Grid>
                                                </Grid>
                                            </Grid>

                                            <Border
                                                Grid.Column="3"
                                                Padding="3"
                                                HorizontalAlignment="Center"
                                                Background="{StaticResource BrushBgPanel}"
                                                BorderBrush="{StaticResource BrushBorderSubtle}"
                                                BorderThickness="1"
                                                CornerRadius="22"
                                                IsVisible="{Binding HasNormalizedSelectedFile}">
                                                <StackPanel Orientation="Horizontal" Spacing="2">
                                                    <Button
                                                        Padding="10,4"
                                                        Classes="segment"
                                                        Classes.active="{Binding IsViewingOriginalMetrics}"
                                                        Command="{Binding ShowOriginalMetricsCommand}"
                                                        FontSize="7">
                                                        <TextBlock FontSize="{StaticResource FontSizeXS}" Text="{l10n:Localize Original}" />
                                                    </Button>
                                                    <Button
                                                        Padding="10,4"
                                                        Classes="segment"
                                                        Classes.active="{Binding IsViewingNormalizedMetrics}"
                                                        Command="{Binding ShowNormalizedMetricsCommand}"
                                                        FontSize="7">
                                                        <TextBlock FontSize="{StaticResource FontSizeXS}" Text="{l10n:Localize Normalized}" />
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                            <!--  Medidor  -->
                                            <Border
                                                Padding="12,12"
                                                Background="{StaticResource bg_degrade}"
                                                BorderBrush="{StaticResource BrushBorderSubtle}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                IsVisible="{Binding HasAnyMeasurement}">

                                                <Grid ColumnDefinitions="*,1,*">

                                                    <!--  Loudness  -->
                                                    <StackPanel
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Spacing="1">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            FontSize="{StaticResource FontSizeMeter}"
                                                            FontWeight="Bold"
                                                            Foreground="{StaticResource BrushAccentSkyblue}"
                                                            Text="{Binding SelectedFileLoudnessValue}" />
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            FontSize="{StaticResource FontSizeSM}"
                                                            FontWeight="Medium"
                                                            Foreground="{StaticResource BrushAccentSecondary}"
                                                            Text="{Binding SelectedFileLoudnessUnit}" />
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            FontSize="{StaticResource FontSizeSM}"
                                                            FontWeight="SemiBold"
                                                            Foreground="{StaticResource BrushTextMuted}"
                                                            Text="{l10n:Localize Loudness}" />
                                                    </StackPanel>

                                                    <!--  Separador  vertical  -->
                                                    <Rectangle
                                                        Grid.Column="1"
                                                        Width="1"
                                                        Margin="0,6"
                                                        Fill="{StaticResource BrushBorderSubtle}" />

                                                    <!--  Info  -->
                                                    <Grid
                                                        Grid.Column="2"
                                                        Margin="14,0,2,0"
                                                        VerticalAlignment="Center"
                                                        RowDefinitions="*,*,*"
                                                        RowSpacing="2">

                                                        <StackPanel Spacing="1">
                                                            <TextBlock
                                                                FontSize="{StaticResource FontSizeMicro}"
                                                                FontWeight="SemiBold"
                                                                Foreground="{StaticResource BrushTextMuted}"
                                                                Text="{l10n:Localize TruePeak}" />
                                                            <TextBlock
                                                                FontSize="{StaticResource FontSizeLarge}"
                                                                FontWeight="SemiBold"
                                                                Foreground="{StaticResource BrushAccent}"
                                                                Text="{Binding SelectedFilePeakText}" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Row="1" Spacing="1">
                                                            <TextBlock
                                                                FontSize="{StaticResource FontSizeMicro}"
                                                                FontWeight="SemiBold"
                                                                Foreground="{StaticResource BrushTextMuted}"
                                                                Text="{l10n:Localize Plr}" />
                                                            <TextBlock
                                                                FontSize="{StaticResource FontSizeLarge}"
                                                                FontWeight="SemiBold"
                                                                Foreground="{StaticResource BrushAccentSecondary}"
                                                                Text="{Binding SelectedFilePlrText}" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Row="2" Spacing="1">
                                                            <TextBlock
                                                                FontSize="{StaticResource FontSizeMicro}"
                                                                FontWeight="SemiBold"
                                                                Foreground="{StaticResource BrushTextMuted}"
                                                                Text="{l10n:Localize Lra}" />
                                                            <TextBlock
                                                                FontSize="{StaticResource FontSizeLarge}"
                                                                FontWeight="SemiBold"
                                                                Foreground="{StaticResource BrushAccentSecondary}"
                                                                Text="{Binding SelectedFileLraText}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <!--  Relación con el objetivo (vista original)  -->
                                            <Grid
                                                ColumnDefinitions="*,Auto"
                                                IsVisible="{Binding IsViewingOriginalMetrics}"
                                                RowSpacing="3">
                                                <StackPanel Spacing="1">
                                                    <TextBlock
                                                        FontSize="{StaticResource FontSizeMicro}"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource BrushTextMuted}"
                                                        Text="{Binding SelectedFileGainLabelText}" />
                                                    <TextBlock
                                                        FontSize="{StaticResource FontSizeLG}"
                                                        FontWeight="SemiBold"
                                                        Foreground="{Binding SelectedFileGainBrush}"
                                                        Text="{Binding SelectedFileGainNeeded}" />
                                                </StackPanel>

                                                <!--  Estado  -->
                                                <Border
                                                    Grid.Column="1"
                                                    Padding="10,3"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding SelectedFileGainBgBrush}"
                                                    CornerRadius="999">
                                                    <TextBlock
                                                        FontSize="{StaticResource FontSizeSmall}"
                                                        FontWeight="SemiBold"
                                                        Foreground="{Binding SelectedFileGainBrush}"
                                                        Text="{Binding SelectedFileGainStatus}" />
                                                </Border>
                                            </Grid>

                                            <!--  Desviación respecto al objetivo (vista normalizada)  -->
                                            <Grid
                                                ColumnDefinitions="*,Auto"
                                                IsVisible="{Binding IsViewingNormalizedMetrics}"
                                                RowSpacing="3">
                                                <StackPanel Spacing="1">
                                                    <TextBlock
                                                        FontSize="{StaticResource FontSizeMicro}"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource BrushTextMuted}"
                                                        Text="{l10n:Localize Deviation}" />
                                                    <TextBlock
                                                        FontSize="{StaticResource FontSizeLG}"
                                                        FontWeight="SemiBold"
                                                        Foreground="{Binding SelectedFile.NormLoudnessBrush}"
                                                        Text="{Binding SelectedFileDeviationText}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>

                                        <!--  Aviso  -->
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="{StaticResource FontSizeSM}"
                                            Foreground="{StaticResource BrushTextMuted}"
                                            IsVisible="{Binding !HasSelectedFile}"
                                            Text="{l10n:Localize NoSelectionHint}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!--  2. Resumen del lote  -->
                                <Border
                                    Padding="14"
                                    Background="{StaticResource BrushBgPanelAlt}"
                                    BorderBrush="{StaticResource BrushBorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <StackPanel Spacing="12">
                                        <!--  Cabecera del card  -->
                                        <Grid VerticalAlignment="Center" ColumnDefinitions="Auto,6,*">
                                            <Ellipse
                                                Width="7"
                                                Height="7"
                                                Fill="{StaticResource BrushAccentSkyblue}" />
                                            <TextBlock
                                                Grid.Column="2"
                                                FontSize="{StaticResource FontSizeSmall}"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource BrushTextMuted}"
                                                Text="{l10n:Localize BatchSummary}" />
                                        </Grid>

                                        <!--  Métricas principales  -->
                                        <Grid ColumnDefinitions="2*,10,2*,10,2*">
                                            <Border
                                                Grid.Column="0"
                                                Padding="8,10"
                                                Background="{StaticResource BrushBgInput}"
                                                BorderBrush="{StaticResource BrushBorderSubtle}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                                <StackPanel Spacing="2">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        FontSize="{StaticResource FontSizeMicro}"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource BrushTextMuted}"
                                                        Text="{l10n:Localize Average}" />
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        FontSize="{StaticResource FontSizeLG}"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource BrushAccentSkyblue}"
                                                        Text="{Binding SummaryAverageText}" />
                                                </StackPanel>
                                            </Border>
                                            <Border
                                                Grid.Column="2"
                                                Padding="8,10"
                                                Background="{StaticResource BrushBgInput}"
                                                BorderBrush="{StaticResource BrushBorderSubtle}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                                <StackPanel Spacing="2">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        FontSize="{StaticResource FontSizeMicro}"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource BrushTextMuted}"
                                                        Text="{l10n:Localize AvgGain}" />
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        FontSize="{StaticResource FontSizeLG}"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource BrushTextPrimary}"
                                                        Text="{Binding SummaryAvgGainText}" />
                                                </StackPanel>
                                            </Border>
                                            <Border
                                                Grid.Column="4"
                                                Padding="8,10"
                                                Background="{StaticResource BrushBgInput}"
                                                BorderBrush="{StaticResource BrushBorderSubtle}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                                <StackPanel Spacing="2">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        FontSize="{StaticResource FontSizeMicro}"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource BrushTextMuted}"
                                                        Text="{l10n:Localize MaxPeak}" />
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        FontSize="{StaticResource FontSizeLG}"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource BrushTextPrimary}"
                                                        Text="{Binding SummaryPeakText}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!--  Métricas secundarias  -->
                                        <Grid ColumnDefinitions="*,20,*">
                                            <StackPanel Spacing="10">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock
                                                        FontSize="{StaticResource FontSizeSM}"
                                                        Foreground="{StaticResource BrushTextSecondary}"
                                                        Text="{l10n:Localize Measured}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        FontSize="{StaticResource FontSizeSM}"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource BrushTextPrimary}"
                                                        Text="{Binding SummaryMeasuredText}" />
                                                </Grid>
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock
                                                        FontSize="{StaticResource FontSizeSM}"
                                                        Foreground="{StaticResource BrushTextSecondary}"
                                                        Text="{l10n:Localize Range}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        FontSize="{StaticResource FontSizeSM}"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource BrushTextPrimary}"
                                                        Text="{Binding SummaryRangeText}"
                                                        TextWrapping="Wrap" />
                                                </Grid>
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock
                                                        FontSize="{StaticResource FontSizeSM}"
                                                        Foreground="{StaticResource BrushTextSecondary}"
                                                        Text="{l10n:Localize AvgLra}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        FontSize="{StaticResource FontSizeSM}"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource BrushAccentSecondary}"
                                                        Text="{Binding SummaryLraText}"
                                                        TextWrapping="Wrap" />
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Spacing="10">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock
                                                        FontSize="{StaticResource FontSizeSM}"
                                                        Foreground="{StaticResource BrushTextSecondary}"
                                                        Text="{l10n:Localize OnTarget}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        FontSize="{StaticResource FontSizeSM}"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource BrushAccentGreen}"
                                                        Text="{Binding SummaryOnTargetText}" />
                                                </Grid>
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock
                                                        FontSize="{StaticResource FontSizeSM}"
                                                        Foreground="{StaticResource BrushTextSecondary}"
                                                        Text="{l10n:Localize MaxDeviation}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        FontSize="{StaticResource FontSizeSM}"
                                                        FontWeight="SemiBold"
                                                        Foreground="{Binding SummaryMaxDeviationBrush}"
                                                        Text="{Binding SummaryMaxDeviationText}" />
                                                </Grid>
                                            </StackPanel>
                                        </Grid>

                                        <!--  Estado vacío  -->
                                        <StackPanel IsVisible="{Binding !HasAnyMeasurement}" Spacing="10">
                                            <Rectangle Height="1" Fill="{StaticResource BrushBorderSubtle}" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="{StaticResource FontSizeSM}"
                                                Foreground="{StaticResource BrushTextMuted}"
                                                Text="{l10n:Localize BatchEmptyHint}"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!--  Botón principal de ejecución  -->
                    <Button
                        Grid.Row="2"
                        Height="44"
                        Margin="18"
                        HorizontalAlignment="Stretch"
                        Classes="main"
                        Command="{Binding StartNormalizationCommand}">
                        <StackPanel
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Path
                                Width="15"
                                Height="15"
                                VerticalAlignment="Center"
                                Data="M8,5 L19,12 L8,19 Z"
                                Fill="{StaticResource BrushTextOnAccent}"
                                IsVisible="{Binding !IsProcessing}"
                                Stretch="Uniform" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{StaticResource BrushTextOnAccent}"
                                IsVisible="{Binding ShowRunNormalizationLabel}"
                                Text="{l10n:Localize RunBatchNormalization}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{StaticResource BrushTextOnAccent}"
                                IsVisible="{Binding ShowRunAnalysisLabel}"
                                Text="{l10n:Localize RunBatchAnalysis}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontSizeLG}"
                                Foreground="{StaticResource BrushTextOnAccent}"
                                IsVisible="{Binding IsProcessing}"
                                Text="{l10n:Localize Processing}" />
                        </StackPanel>
                    </Button>
                </Grid>

            </Border>
        </Grid>

        <!--
            ==========================================================
            BARRA DE ESTADO GLOBAL
            ==========================================================
        -->
        <Border
            Grid.Row="2"
            Padding="12,7"
            Background="{StaticResource BrushBgPanel}"
            BorderBrush="{StaticResource BrushBorderDefault}"
            BorderThickness="1"
            Classes.ok="{Binding IsStatusSuccess}"
            CornerRadius="8">
            <Grid ColumnDefinitions="16,*">
                <Ellipse
                    Width="6"
                    Height="6"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Fill="{StaticResource BrushAccentSkyblue}" />

                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource FontMono}"
                    FontSize="{StaticResource FontSizeMedium}"
                    Foreground="{StaticResource BrushTextSecondary}"
                    Text="{Binding SystemStatus}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </Grid>
        </Border>

        <!--
            ==========================================================
            MODAL DE CANCELACIÓN
            Fondo semitransparente sobre toda la ventana + panel central
            con el progreso del lote en curso y el botón de cancelar.
            Se muestra mientras IsProcessing esté activo.
            ==========================================================
        -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="3"
            Margin="-18,-4,-18,-18"
            IsVisible="{Binding IsProcessing}">

            <!--  Scrim: semitransparente, bloquea clics a la app  -->
            <Border Background="{StaticResource BrushBgOverlay}" Opacity="0.62" />

            <!--  Panel central  -->
            <Border
                Width="480"
                Padding="28,24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource BrushBgPanel}"
                BorderBrush="{StaticResource BrushBorderStrong}"
                BorderThickness="1"
                BoxShadow="0 12 32 0 #66000000"
                CornerRadius="12">
                <StackPanel Spacing="16">

                    <!--  Encabezado: icono + título  -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Path
                            Width="22"
                            Height="22"
                            VerticalAlignment="Center"
                            Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z"
                            Fill="{StaticResource BrushAccentCyan}"
                            Stretch="Uniform" />

                        <!--  Título Normalizar  -->
                        <TextBlock
                            FontSize="{StaticResource FontSizeDisplay}"
                            FontWeight="Bold"
                            Foreground="{StaticResource BrushTextPrimary}"
                            IsVisible="{Binding IsNormalizeMode}"
                            Text="{l10n:Localize ModalNormalizingTitle}" />

                        <!--  Título Analizar  -->
                        <TextBlock
                            FontSize="{StaticResource FontSizeDisplay}"
                            FontWeight="Bold"
                            Foreground="{StaticResource BrushTextPrimary}"
                            IsVisible="{Binding IsAnalyzeMode}"
                            Text="{l10n:Localize ModalAnalyzingTitle}" />
                    </StackPanel>

                    <!--  Descripción  -->
                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource BrushTextSecondary}"
                        Text="{l10n:Localize ModalWait}"
                        TextWrapping="Wrap" />

                    <!--  Barra indeterminada + contadores reales del lote  -->
                    <StackPanel Spacing="8">
                        <ProgressBar
                            Height="6"
                            Background="{StaticResource BrushBorderDefault}"
                            Foreground="{StaticResource BrushAccent}"
                            IsIndeterminate="True" />

                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock
                                FontFamily="{StaticResource FontMono}"
                                FontSize="{StaticResource FontSizeSM}"
                                Foreground="{StaticResource BrushTextPrimary}"
                                Text="{Binding QueueCountersText}" />
                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="5">
                                <TextBlock
                                    FontFamily="{StaticResource FontMono}"
                                    FontSize="{StaticResource FontSizeSM}"
                                    Foreground="{StaticResource BrushTextMuted}"
                                    Text="{l10n:Localize ModalTime}" />
                                <TextBlock
                                    FontFamily="{StaticResource FontMono}"
                                    FontSize="{StaticResource FontSizeSM}"
                                    Foreground="{StaticResource BrushTextSecondary}"
                                    Text="{Binding ElapsedText}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!--  Botón de cancelar  -->
                    <Button
                        Margin="0,8,0,0"
                        HorizontalAlignment="Stretch"
                        Classes="main"
                        Command="{Binding CancelProcessingCommand}"
                        IsEnabled="{Binding !IsCancelling}">
                        <StackPanel
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">

                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontSizeBase}"
                                Foreground="{StaticResource BrushTextOnAccent}"
                                IsVisible="{Binding !IsCancelling}"
                                Text="{l10n:Localize ModalCancel}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontSizeBase}"
                                Foreground="{StaticResource BrushTextOnAccent}"
                                IsVisible="{Binding IsCancelling}"
                                Text="{l10n:Localize ModalCancelling}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
