<Window
    x:Class="ElysiumAudio.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ElysiumAudio.Controls"
    xmlns:conv="using:ElysiumAudio.Converters"
    xmlns:customControls="using:ElysiumAudio.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l10n="using:ElysiumAudio.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ElysiumAudio.Models"
    xmlns:netDataGrid="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
    xmlns:vm="using:ElysiumAudio.ViewModels"
    Title="Elysium Audio"
    Width="1200"
    Height="748"
    MinWidth="1024"
    MinHeight="640"
    d:DesignHeight="720"
    d:DesignWidth="1180"
    x:DataType="vm:MainWindowViewModel"
    Background="{StaticResource BrushBgBase}"
    Foreground="{StaticResource BrushTextPrimary}"
    Icon="/Assets/elysium.ico"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.Resources>
        <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
        <conv:DynamicNumberFormatConverter x:Key="DynamicNumberFormatConverter" />
        <conv:RowAlternationConverter x:Key="RowAlternationConverter" />
    </Window.Resources>

    <Grid
        Margin="18,4,18,18"
        RowDefinitions="Auto, *, Auto"
        RowSpacing="16">
        <!--
            ==========================================================
            CUERPO PRINCIPAL
            Columna izquierda: controles de masterización
            Columna derecha: tabla de archivos
            ==========================================================
        -->
        <Grid
            Grid.Row="1"
            ColumnDefinitions="*, 368"
            ColumnSpacing="16">

            <!--  ***************** ZONA IZQUIERDO: COLA DE ARCHIVOS *****************  -->
            <Grid
                Grid.Column="0"
                RowDefinitions="Auto, *, 80"
                RowSpacing="16">


                <!--  Barra de acciones de la cola  -->
                <Border
                    Grid.Row="0"
                    Padding="14,10"
                    Background="{StaticResource BrushBgPanel}"
                    BorderBrush="{StaticResource BrushBorderDefault}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                        <!--
                            Acciones de la cola, todas a la izquierda y con la
                            misma métrica (mismo alto, tipografía y radio) para que
                            se lean como una familia. "Agregar" es la acción
                            primaria: mismo tamaño, pero con un tinte de acento
                            suave que la distingue sin gritar.
                        -->
                        <StackPanel
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">

                            <!--
                                Botón split: clic = agregar archivos (lo más
                                frecuente), flecha = archivos / carpeta / ajustes.
                            -->
                            <SplitButton
                                Classes="queue"
                                Command="{Binding AddFileCommand}"
                                Content="{l10n:Localize Add}">
                                <SplitButton.Flyout>
                                    <MenuFlyout FlyoutPresenterClasses="queue-flyout">
                                        <MenuItem Click="OnAddFilesMenuClick" Header="{l10n:Localize AddFiles}">
                                            <MenuItem.Icon>

                                                <Path
                                                    Width="14"
                                                    Height="14"
                                                    Data="M9 18V5l12-2v13 M3 3v6 M0 6h6 M9 18a3 3 0 1 1-6 0a3 3 0 1 1 6 0 M21 16a3 3 0 1 1-6 0a3 3 0 1 1 6 0"
                                                    Fill="Transparent"
                                                    Stretch="Uniform"
                                                    Stroke="{Binding $parent[MenuItem].Foreground}"
                                                    StrokeJoin="Round"
                                                    StrokeLineCap="Round"
                                                    StrokeThickness="1.5" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Click="OnAddFolderMenuClick" Header="{l10n:Localize AddFolder}">
                                            <MenuItem.Icon>
                                                <Path
                                                    Width="14"
                                                    Height="14"
                                                    Data="M2,4 C2,2.9 2.9,2 4,2 H9 L11,4 H20 C21.1,4 22,4.9 22,6 V18 C22,19.1 21.1,20 20,20 H4 C2.9,20 2,19.1 2,18 V4 Z M4,6 V18 H20 V6 H11.7 L9.7,4 H4 V6 Z M11,9 H13 V11 H15 V13 H13 V15 H11 V13 H9 V11 H11 V9 Z"
                                                    Fill="{Binding $parent[MenuItem].Foreground}"
                                                    Stretch="Uniform" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator Background="{StaticResource BrushBorderSubtle}" />
                                        <MenuItem Click="OnSettingsMenuClick" Header="{l10n:Localize Settings}">
                                            <MenuItem.Icon>
                                                <Path
                                                    Width="14"
                                                    Height="14"
                                                    Data="M19.14,12.94 C19.18,12.64 19.2,12.32 19.2,12 C19.2,11.68 19.18,11.36 19.14,11.06 L21.16,9.48 C21.34,9.34 21.39,9.08 21.27,8.87 L19.36,5.55 C19.24,5.34 18.99,5.26 18.77,5.34 L16.38,6.3 C15.88,5.92 15.34,5.59 14.74,5.35 L14.38,2.82 C14.35,2.58 14.15,2.4 13.9,2.4 H10.1 C9.85,2.4 9.65,2.58 9.62,2.82 L9.26,5.35 C8.66,5.59 8.12,5.92 7.62,6.3 L5.23,5.34 C5.01,5.26 4.76,5.34 4.64,5.55 L2.73,8.87 C2.61,9.08 2.66,9.34 2.84,9.48 L4.86,11.06 C4.82,11.36 4.8,11.68 4.8,12 C4.8,12.32 4.82,12.64 4.86,12.94 L2.84,14.52 C2.66,14.66 2.61,14.92 2.73,15.13 L4.64,18.45 C4.76,18.66 5.01,18.74 5.23,18.66 L7.62,17.7 C8.12,18.08 8.66,18.41 9.26,18.65 L9.62,21.18 C9.65,21.42 9.85,21.6 10.1,21.6 H13.9 C14.15,21.6 14.35,21.42 14.38,21.18 L14.74,18.65 C15.34,18.41 15.88,18.08 16.38,17.7 L18.77,18.66 C18.99,18.74 19.24,18.66 19.36,18.45 L21.27,15.13 C21.39,14.92 21.34,14.66 21.16,14.52 L19.14,12.94 Z M12,15.6 C10.01,15.6 8.4,13.99 8.4,12 C8.4,10.01 10.01,8.4 12,8.4 C13.99,8.4 15.6,10.01 15.6,12 C15.6,13.99 13.99,15.6 12,15.6 Z"
                                                    Fill="{Binding $parent[MenuItem].Foreground}"
                                                    Stretch="Uniform" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </MenuFlyout>
                                </SplitButton.Flyout>
                            </SplitButton>

                            <Button Classes="ghost" Command="{Binding ClearListCommand}">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource FontSizeMedium}"
                                    Foreground="{StaticResource TextAccentSecondary}"
                                    Text="{l10n:Localize Clear}" />
                            </Button>

                            <Button Classes="ghost" Command="{Binding ResetQueueCommand}">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource FontSizeMedium}"
                                    Foreground="{StaticResource TextAccentSecondary}"
                                    Text="{l10n:Localize Reset}" />
                            </Button>
                        </StackPanel>

                        <!--  Cantidad total  -->
                        <Border
                            Grid.Column="2"
                            Padding="12,6"
                            VerticalAlignment="Center"
                            Background="{StaticResource BrushBgInput}"
                            BorderBrush="{StaticResource BrushBorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="999">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextAccentSecondary}"
                                    Text="{l10n:Localize Tracks}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource BrushAccentSkyblue}"
                                    Text="{Binding SummaryTotalText}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>


                <!--  Zona de arrastre con el DataGrid  -->
                <Border
                    Name="DropZoneBorder"
                    Grid.Row="1"
                    Background="{StaticResource BrushBgPanel}"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    ClipToBounds="True"
                    CornerRadius="12"
                    DragDrop.AllowDrop="True">

                    <Grid>
                        <DataGrid
                            x:Name="AudioFilesGrid"
                            AutoGenerateColumns="False"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CanUserReorderColumns="True"
                            CanUserResizeColumns="True"
                            ColumnHeaderHeight="48"
                            CornerRadius="12"
                            GridLinesVisibility="None"
                            IsReadOnly="True"
                            ItemsSource="{Binding AudioFiles}"
                            KeyDown="OnQueueKeyDown"
                            RowHeight="50"
                            SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                            SelectionMode="Extended">

                            <DataGrid.Styles>
                                <!--  Texto general  -->
                                <Style Selector="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="FontSize" Value="{StaticResource FontSizeMD}" />
                                </Style>

                                <!--  Encabezados  -->
                                <Style Selector="DataGridColumnHeader">
                                    <Setter Property="Template">
                                        <ControlTemplate>
                                            <Border
                                                Background="#10121C"
                                                BorderBrush="Transparent"
                                                BorderThickness="0">
                                                <ContentPresenter
                                                    Margin="0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    RecognizesAccessKey="True" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter>
                                </Style>

                                <!--  Encabezados centrados a 2 líneas  -->
                                <Style Selector="DataGridColumnHeader TextBlock">
                                    <Setter Property="TextAlignment" Value="Center" />
                                    <Setter Property="TextWrapping" Value="NoWrap" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="MaxLines" Value="2" />
                                    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                </Style>

                                <!--  Fila: fondo alternado = dos tonos de superficie (zebra)  -->
                                <Style Selector="DataGridRow">
                                    <Setter Property="Background" Value="{Binding Index, RelativeSource={RelativeSource Self}, Converter={StaticResource RowAlternationConverter}}" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                </Style>

                                <!--
                                    Estados de fila: el azul del tema se pinta sobre
                                    Rectangle#BackgroundRectangle de la plantilla, así que se
                                    sobrescribe ese rectángulo (capa de realce) en lugar del
                                    Background del control. El hover es traslúcido para que la
                                    alternancia de filas siga percibiéndose debajo.
                                -->
                                <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
                                    <Setter Property="Fill" Value="{StaticResource BrushBgElevated}" />
                                    <Setter Property="Opacity" Value="0.55" />
                                </Style>
                                <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
                                    <Setter Property="Fill" Value="{StaticResource BrushBgElevated}" />
                                    <Setter Property="Opacity" Value="1" />
                                </Style>
                                <Style Selector="DataGridRow:selected:pointerover /template/ Rectangle#BackgroundRectangle">
                                    <Setter Property="Fill" Value="{StaticResource BrushBgElevated}" />
                                    <Setter Property="Opacity" Value="1" />
                                </Style>
                                <Style Selector="DataGridRow:selected:focus /template/ Rectangle#BackgroundRectangle">
                                    <Setter Property="Fill" Value="{StaticResource BrushBgElevated}" />
                                    <Setter Property="Opacity" Value="1" />
                                </Style>
                                <Style Selector="DataGridRow:selected:pointerover:focus /template/ Rectangle#BackgroundRectangle">
                                    <Setter Property="Fill" Value="{StaticResource BrushBgElevated}" />
                                    <Setter Property="Opacity" Value="1" />
                                </Style>

                                <!--
                                    Celdas (solo lectura: sin foco ni selección propia).
                                    El borde blanco al hacer clic es el Grid#FocusVisual de la
                                    plantilla; se oculta en :focus y el cursor se oculta también.
                                -->
                                <Style Selector="DataGridCell">
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="FocusAdorner" Value="{x:Null}" />
                                    <Setter Property="Focusable" Value="False" />
                                </Style>
                                <Style Selector="DataGridCell:focus /template/ Grid#FocusVisual">
                                    <Setter Property="IsVisible" Value="False" />
                                </Style>
                                <Style Selector="DataGridCell:current /template/ Rectangle#CurrencyVisual">
                                    <Setter Property="IsVisible" Value="False" />
                                </Style>
                                <Style Selector="DataGridCell:focus">
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="FocusAdorner" Value="{x:Null}" />
                                </Style>
                                <Style Selector="DataGridCell:selected">
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="DataGridCell:selected:focus">
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="DataGridCell:current:selected">
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="DataGridCell:pointerover">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                </Style>

                                <!--  Separador sutil bajo los encabezados (en vez de rejilla)  -->
                                <Style Selector="DataGrid /template/ Rectangle#PART_ColumnHeadersAndRowsSeparator">
                                    <Setter Property="Fill" Value="{StaticResource BrushBorderSubtle}" />
                                </Style>

                                <!--  Esquina inferior derecha de los scrollbars  -->
                                <Style Selector="DataGrid /template/ Rectangle#PART_BottomRightCorner">
                                    <Setter Property="Fill" Value="{StaticResource BrushBgPanel}" />
                                </Style>
                            </DataGrid.Styles>

                            <!--  Columnas  -->
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="0.5*" MinWidth="60">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="{l10n:Localize GridState}" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:AudioFileModel">
                                            <customControls:AudioStatusIndicator
                                                Width="32"
                                                Height="32"
                                                HorizontalAlignment="Center"
                                                Status="{Binding Status}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn
                                    Width="2*"
                                    MinWidth="120"
                                    Binding="{Binding FileName}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{l10n:Localize GridFileName}" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Width="0.*" MinWidth="80">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="{l10n:Localize GridCodec}" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:AudioFileModel">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="{StaticResource FontSizeMD}"
                                                Text="{Binding Codec}"
                                                TextAlignment="Center"
                                                TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="*" MinWidth="108">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="{l10n:Localize GridDuration}" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:AudioFileModel">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="{StaticResource FontSizeMD}"
                                                Text="{Binding Duration}"
                                                TextAlignment="Center"
                                                TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="0.6*" MinWidth="90">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="{l10n:Localize GridLufs}" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:AudioFileModel">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="{StaticResource FontSizeMD}"
                                                Foreground="{Binding InputLoudnessBrush}"
                                                Text="{Binding Loudness}"
                                                TextAlignment="Center"
                                                TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="*" MinWidth="98">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="{l10n:Localize GridPeak}" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:AudioFileModel">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="{StaticResource FontSizeMD}"
                                                Foreground="{Binding InputPeakBrush}"
                                                Text="{Binding Peak}"
                                                TextAlignment="Center"
                                                TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="*" MinWidth="98">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="{l10n:Localize GridNormLufs}" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:AudioFileModel">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="{StaticResource FontSizeMD}"
                                                FontWeight="SemiBold"
                                                Foreground="{Binding NormLoudnessBrush}"
                                                Text="{Binding NormalizedLoudness}"
                                                TextAlignment="Center"
                                                TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="*" MinWidth="98">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Margin="8,0" Text="{l10n:Localize GridNormPeak}" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:AudioFileModel">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="{StaticResource FontSizeMD}"
                                                FontWeight="SemiBold"
                                                Foreground="{Binding NormPeakBrush}"
                                                Text="{Binding NormalizedPeak}"
                                                TextAlignment="Center"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!--  Borde del Grid  -->
                        <Border
                            Background="Transparent"
                            BorderBrush="{StaticResource BrushBorderDefault}"
                            BorderThickness="1"
                            CornerRadius="12"
                            IsHitTestVisible="False" />

                        <!--  Estado vacío: hint de arrastre  -->
                        <StackPanel
                            Margin="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsVisible="{Binding AudioFiles.Count, Converter={StaticResource CountToVisibilityConverter}}"
                            Spacing="12">
                            <Path
                                Width="34"
                                Height="34"
                                HorizontalAlignment="Center"
                                Data="M4,24 L10,24 L14,15 L19,35 L24,6 L29,30 L34,18 L37,24 L44,24"
                                Stretch="Uniform"
                                Stroke="{StaticResource BrushTextMuted}"
                                StrokeLineCap="Round"
                                StrokeThickness="1.5" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="{StaticResource FontSizeBase}"
                                FontWeight="Medium"
                                Foreground="{StaticResource BrushTextSecondary}"
                                Text="{l10n:Localize DropHintTitle}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="{StaticResource FontSizeSM}"
                                Foreground="{StaticResource BrushTextMuted}"
                                Text="{l10n:Localize DropHintSubtitle}" />
                        </StackPanel>

                    </Grid>
                </Border>

                <!--  Controle Inferior Izquierdo  -->
                <Border
                    Grid.Row="2"
                    Padding="16,10"
                    Background="{StaticResource BrushBgPanel}"
                    BorderBrush="{StaticResource BrushBorderDefault}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <Grid ColumnDefinitions="1.2*,16,2.0*,16,1*">

                        <!--  Formato de salida  -->
                        <Button
                            x:Name="FormatButton"
                            Height="50"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="{StaticResource BrushBgPanelAlt}"
                            BorderBrush="{StaticResource BrushBorderSubtle}"
                            Classes="ghostNoZoom"
                            Command="{Binding TogglePopupCommand}"
                            CornerRadius="8">
                            <Button.Flyout>
                                <Flyout
                                    Closed="OnFlyoutClosed"
                                    IsOpen="{Binding IsFlyoutOpen}"
                                    Placement="Bottom"
                                    ShowMode="Standard">

                                    <ListBox
                                        MinWidth="200"
                                        Classes="dark-popup"
                                        ItemsSource="{Binding OutputFormatOptions}"
                                        SelectedItem="{Binding SelectedFormat}"
                                        SelectionMode="Single">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    Margin="20,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="{StaticResource FontSizeMD}"
                                                    Text="{Binding}" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Flyout>
                            </Button.Flyout>

                            <Grid ColumnDefinitions="*,14">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        FontSize="{StaticResource FontSizeSmall}"
                                        Foreground="{StaticResource BrushTextMuted}"
                                        Text="{l10n:Localize OutputFormat}" />
                                    <TextBlock
                                        FontSize="{StaticResource FontSizeMedium}"
                                        Foreground="{StaticResource BrushTextSecondary}"
                                        Text="{Binding SelectedFormat}" />
                                </StackPanel>

                                <Path
                                    Grid.Column="1"
                                    Width="8"
                                    Height="4"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Data="M0,0 L4,4 L8,0"
                                    Fill="Transparent"
                                    Stretch="None"
                                    Stroke="{StaticResource TextMuted}"
                                    StrokeJoin="Round"
                                    StrokeLineCap="Round"
                                    StrokeThickness="1.5" />
                            </Grid>
                        </Button>

                        <!--  Directorio de salida  -->
                        <Button
                            Grid.Column="2"
                            Height="50"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="{StaticResource BrushBgPanelAlt}"
                            BorderBrush="{StaticResource BrushBorderSubtle}"
                            Classes="ghostNoZoom"
                            Command="{Binding SelectOutputDirectoryCommand}"
                            CornerRadius="8">
                            <StackPanel Spacing="4">
                                <TextBlock
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Foreground="{StaticResource BrushTextMuted}"
                                    Text="{l10n:Localize OutputDirectory}" />
                                <TextBlock
                                    FontSize="{StaticResource FontSizeMedium}"
                                    Foreground="{StaticResource BrushTextSecondary}"
                                    Text="{Binding OutputDirectory}"
                                    TextWrapping="NoWrap" />
                            </StackPanel>
                        </Button>

                        <!--  Explorar Directorio  -->
                        <Button
                            Grid.Column="4"
                            Height="50"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="{StaticResource BrushBgPanelAlt}"
                            BorderBrush="{StaticResource BrushBorderSubtle}"
                            Classes="ghostNoZoom"
                            Command="{Binding ExploreOutputDirectoryCommand}"
                            CornerRadius="8">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontSizeSmall}"
                                Foreground="{StaticResource BrushTextMuted}"
                                Text="{l10n:Localize ExploreDirectory}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!--  ***************** PANEL DERECHO: CONTROLES *****************  -->
            <Border
                x:Name="DropZoneRight"
                Grid.Column="1"
                Background="{StaticResource BrushBgPanel}"
                BorderBrush="{StaticResource BrushBorderDefault}"
                BorderThickness="1"
                CornerRadius="12"
                DragDrop.AllowDrop="True"
                Focusable="True">

                <!--  Contenerdor de controles y Botón Batch  -->
                <Grid RowDefinitions="Auto,*, Auto">

                    <!--  Selector de función principal (Normalizar / Analizar)  -->
                    <Border
                        Height="40"
                        Margin="14,12,14,8"
                        Padding="4"
                        VerticalAlignment="Center"
                        Background="{StaticResource BrushBgInput}"
                        BorderBrush="{StaticResource BrushBorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="24">
                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="4"
                            IsEnabled="{Binding !IsProcessing}">
                            <!--  Botón Analizar  -->
                            <Button
                                Grid.Column="0"
                                Classes="segment"
                                Classes.active="{Binding IsAnalyzeMode}"
                                Command="{Binding SetAnalyzeModeCommand}">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Path
                                        Width="15"
                                        Height="15"
                                        VerticalAlignment="Center"
                                        Data="M7.5,1 L7.5,14 M1,7.5 L14,7.5 M4,7.5 C4,5.5 5.5,4 7.5,4 C9.5,4 11,5.5 11,7.5 C11,9.5 9.5,11 7.5,11 C5.5,11 4,9.5 4,7.5 Z"
                                        Fill="Transparent"
                                        Stroke="{StaticResource BrushAccentSecondary}"
                                        StrokeLineCap="Round"
                                        StrokeThickness="1.7" />
                                    <TextBlock VerticalAlignment="Center" Text="{l10n:Localize Analyze}" />
                                </StackPanel>
                            </Button>
                            <!--  Botón Normalizar  -->
                            <Button
                                Grid.Column="1"
                                Classes="segment"
                                Classes.active="{Binding IsNormalizeMode}"
                                Command="{Binding SetNormalizeModeCommand}">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Path
                                        Width="15"
                                        Height="15"
                                        VerticalAlignment="Center"
                                        Data="M2,7.5 L4,4 L6,11 L8,6 L10,9 L13,7.5"
                                        Fill="Transparent"
                                        Stroke="{StaticResource BrushAccentSecondary}"
                                        StrokeLineCap="Round"
                                        StrokeThickness="1.7" />
                                    <TextBlock VerticalAlignment="Center" Text="{l10n:Localize Normalize}" />
                                </StackPanel>
                            </Button>

                        </Grid>
                    </Border>

                    <!--  Controles Normalize/Analysis  -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="16,12,16,0">

                            <!--  1. Panel de Normalilzar (modo normalizar)  -->
                            <Grid
                                IsVisible="{Binding IsNormalizeMode}"
                                RowDefinitions="Auto, Auto, Auto"
                                RowSpacing="12">

                                <!--  1.0 Encabezado de la función activa  -->
                                <StackPanel
                                    Grid.Row="0"
                                    Margin="4,0"
                                    IsVisible="{Binding IsNormalizeMode}"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        FontSize="{StaticResource FontSizeXL}"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource BrushAccentSkyblue}"
                                        Text="{l10n:Localize Dsp}" />
                                    <TextBlock
                                        FontSize="{StaticResource FontSizeXL}"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource BrushTextPrimary}"
                                        Text="{l10n:Localize DspSuffix}" />
                                </StackPanel>

                                <!--  1.1 Controles de normalización (focusable para forzar a actualizar los valores)  -->
                                <Border
                                    Grid.Row="1"
                                    Padding="18,18"
                                    Background="{StaticResource Border_bg_degrade2}"
                                    BorderBrush="{StaticResource BrushBorderDefault}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Focusable="True">

                                    <StackPanel Spacing="10">

                                        <!--  Sección: Target Loudness  -->
                                        <Border
                                            Padding="0,10,0,10"
                                            Background="{StaticResource bg_degrade}"
                                            BorderBrush="{StaticResource BrushBorderDefault}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="172" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!--  TITULO  -->
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource BrushTextSecondary}"
                                                    LetterSpacing="2.5"
                                                    Text="{l10n:Localize TargetLufs}" />

                                                <!--  KNOB  -->
                                                <Grid Grid.Row="1" VerticalAlignment="Center">

                                                    <controls:LufsKnob
                                                        x:Name="TargetLufsKnob"
                                                        Width="140"
                                                        Height="140"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Maximum="-6"
                                                        Minimum="-24"
                                                        TickCount="19"
                                                        Value="{Binding TargetLufs, Mode=TwoWay}" />

                                                    <!--  VALOR CENTRAL  -->
                                                    <Grid
                                                        Width="74"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Background="Transparent"
                                                        IsHitTestVisible="False"
                                                        RowDefinitions="Auto, Auto"
                                                        RowSpacing="0">

                                                        <TextBox
                                                            Width="68"
                                                            MinWidth="68"
                                                            MinHeight="24"
                                                            Margin="0"
                                                            Padding="0"
                                                            Background="Transparent"
                                                            BorderBrush="Transparent"
                                                            Classes="param"
                                                            FontSize="16"
                                                            FontWeight="SemiBold"
                                                            Foreground="{StaticResource BrushAccentSkyblue}"
                                                            IsHitTestVisible="False"
                                                            KeyDown="OnTargetLufsKeyDown"
                                                            LostFocus="OnTargetLufsLostFocus"
                                                            Text="{Binding TargetLufs, Mode=OneWay, StringFormat={}{0:F1}}"
                                                            TextAlignment="Center" />

                                                        <TextBlock
                                                            Grid.Row="1"
                                                            HorizontalAlignment="Center"
                                                            FontSize="8.5"
                                                            Foreground="#8B91A3"
                                                            IsHitTestVisible="False"
                                                            LetterSpacing="1"
                                                            Text="LUFS" />
                                                    </Grid>
                                                </Grid>

                                                <!--  PRESETS  -->
                                                <Button
                                                    Grid.Row="2"
                                                    HorizontalAlignment="Center"
                                                    HorizontalContentAlignment="Center"
                                                    Background="{StaticResource BrushBgPanelAlt}"
                                                    BorderBrush="{StaticResource BrushBorderSubtle}"
                                                    Classes="ghostNoZoom"
                                                    Command="{Binding TogglePresetsPopupCommand}"
                                                    CornerRadius="12">

                                                    <Button.Flyout>
                                                        <Flyout
                                                            Closed="OnPresetsFlyoutClosed"
                                                            IsOpen="{Binding IsPresetsFlyoutOpen}"
                                                            ShowMode="Standard">

                                                            <ListBox
                                                                MinWidth="332"
                                                                Classes="dark-popup"
                                                                ItemsSource="{Binding Presets}"
                                                                SelectedItem="{Binding SelectedPreset}"
                                                                SelectionMode="Single">
                                                                <ListBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock
                                                                            Margin="20,0"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="{StaticResource FontSizeMD}"
                                                                            Text="{Binding Name}" />
                                                                    </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                            </ListBox>
                                                        </Flyout>
                                                    </Button.Flyout>

                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock
                                                            FontSize="{StaticResource FontSizeMedium}"
                                                            Foreground="{StaticResource BrushTextSecondary}"
                                                            Text="{Binding SelectedPreset.Name}" />

                                                        <Path
                                                            Grid.Column="1"
                                                            Width="10"
                                                            Height="6"
                                                            Margin="12,0,0,0"
                                                            HorizontalAlignment="Right"
                                                            Data="M 0 0 L 8 0 L 4 5 Z"
                                                            Fill="{StaticResource TextMuted}"
                                                            Stretch="Uniform" />
                                                    </Grid>

                                                </Button>

                                            </Grid>
                                        </Border>

                                        <!--  Sección: parámetros del limitador  -->
                                        <Grid Margin="0,12,0,4" ColumnDefinitions="Auto,10,*">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="{StaticResource FontSizeSmall}"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource BrushTextMuted}"
                                                LetterSpacing="1.5"
                                                Text="{l10n:Localize Limiter}" />
                                            <Border
                                                Grid.Column="2"
                                                Height="1"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource BrushBorderSubtle}" />
                                        </Grid>

                                        <Border
                                            Padding="12,16"
                                            Background="{StaticResource Border_bg_degrade}"
                                            BorderBrush="{StaticResource BrushBorderDefault}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <StackPanel Spacing="12">
												
                                                <!--  Fila: True Peak Ceiling BrushAccentSkyblue  -->
                                                <Grid
                                                    ColumnDefinitions="6,*,Auto,30"
                                                    ColumnSpacing="2"
                                                    RowDefinitions="Auto,Auto">
                                                    <Ellipse
                                                        Width="5"
                                                        Height="5"
                                                        VerticalAlignment="Center"
                                                        Fill="{StaticResource BrushAccentSkyblue}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        FontSize="{StaticResource FontSizeSmall}"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource BrushTextSecondary}"
                                                        Text="{l10n:Localize TruePeakCeiling}" />
                                                    <TextBox
                                                        Grid.RowSpan="2"
                                                        Grid.Column="2"
                                                        Width="48"
                                                        MinHeight="30"
                                                        Padding="0"
                                                        VerticalContentAlignment="Center"
                                                        Background="{StaticResource BrushBgInput}"
                                                        BorderBrush="{StaticResource BrushBorderDefault}"
                                                        BorderThickness="1"
                                                        Classes="param"
                                                        FontFamily="{StaticResource FontMono}"
                                                        FontSize="{StaticResource FontSizeBase}"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource TextAccentSecondary}"
                                                        KeyDown="OnTruePeakKeyDown"
                                                        LostFocus="OnTruePeakLostFocus"
                                                        Text="{Binding TruePeakCeiling, Mode=OneWay, Converter={StaticResource DynamicNumberFormatConverter}}"
                                                        TextAlignment="Center" />
                                                    <TextBlock
                                                        Grid.RowSpan="2"
                                                        Grid.Column="3"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        FontSize="{StaticResource FontSizeXS}"
                                                        Foreground="{StaticResource BrushAccentSkyblue}"
                                                        Text="dBTP" />

                                                    <StackPanel
                                                        Grid.Row="1"
                                                        Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        Spacing="4">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="{StaticResource FontSizeTiny}"
                                                            Foreground="{StaticResource BrushTextMuted}"
                                                            Text="{l10n:Localize RangeOf}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            FontSize="{StaticResource FontSizeTiny}"
                                                            Foreground="{StaticResource BrushTextMuted}"
                                                            Text="{Binding MinTruePeakCeiling, Converter={StaticResource DynamicNumberFormatConverter}}" />
                                                        <TextBlock
                                                            Grid.Column="2"
                                                            VerticalAlignment="Center"
                                                            FontSize="{StaticResource FontSizeTiny}"
                                                            Foreground="{StaticResource BrushTextMuted}"
                                                            Text="{l10n:Localize To}" />
                                                        <TextBlock
                                                            Grid.Column="3"
                                                            VerticalAlignment="Center"
                                                            FontSize="{StaticResource FontSizeTiny}"
                                                            Foreground="{StaticResource BrushTextMuted}"
                                                            Text="{Binding MaxTruePeakCeiling, Converter={StaticResource DynamicNumberFormatConverter}}" />
                                                    </StackPanel>
                                                </Grid>
                                                <!--  Fila: Release Time  -->
                                                <Grid
                                                    ColumnDefinitions="6,*,Auto,30"
                                                    ColumnSpacing="2"
                                                    RowDefinitions="Auto,Auto">
                                                    <Ellipse
                                                        Width="5"
                                                        Height="5"
                                                        VerticalAlignment="Center"
                                                        Fill="{StaticResource BrushAccentRosa}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        FontSize="{StaticResource FontSizeSmall}"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource BrushTextSecondary}"
                                                        Text="{l10n:Localize ReleaseTime}" />
                                                    <TextBox
                                                        Grid.RowSpan="2"
                                                        Grid.Column="2"
                                                        Width="48"
                                                        MinHeight="30"
                                                        Padding="0"
                                                        VerticalContentAlignment="Center"
                                                        Background="{StaticResource BrushBgInput}"
                                                        BorderBrush="{StaticResource BrushBorderDefault}"
                                                        BorderThickness="1"
                                                        Classes="param"
                                                        FontFamily="{StaticResource FontMono}"
                                                        FontSize="{StaticResource FontSizeBase}"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource TextAccentSecondary}"
                                                        KeyDown="OnReleaseTimeMsKeyDown"
                                                        LostFocus="OnReleaseTimeMsLostFocus"
                                                        Text="{Binding ReleaseTimeMs, Mode=OneWay, Converter={StaticResource DynamicNumberFormatConverter}}"
                                                        TextAlignment="Center" />
                                                    <TextBlock
                                                        Grid.RowSpan="2"
                                                        Grid.Column="3"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        FontSize="{StaticResource FontSizeXS}"
                                                        Foreground="{StaticResource BrushAccentRosa}"
                                                        Text="ms" />

                                                    <StackPanel
                                                        Grid.Row="1"
                                                        Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        Spacing="4">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="{StaticResource FontSizeTiny}"
                                                            Foreground="{StaticResource BrushTextMuted}"
                                                            Text="{l10n:Localize RangeOf}" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="{StaticResource FontSizeTiny}"
                                                            Foreground="{StaticResource BrushTextMuted}"
                                                            Text="{Binding MinReleaseTimeMs, Converter={StaticResource DynamicNumberFormatConverter}}" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="{StaticResource FontSizeTiny}"
                                                            Foreground="{StaticResource BrushTextMuted}"
                                                            Text="{l10n:Localize To}" />
                                                        <TextBlock
                                                            Grid.Column="2"
                                                            VerticalAlignment="Center"
                                                            FontSize="{StaticResource FontSizeTiny}"
                                                            Foreground="{StaticResource BrushTextMuted}"
                                                            Text="{Binding MaxReleaseTimeMs, Converter={StaticResource DynamicNumberFormatConverter}}" />
                                                    </StackPanel>
                                                </Grid>

                                                <!--  Fila: Look-ahead Time  -->
                                                <Grid
                                                    ColumnDefinitions="6,*,Auto,30"
                                                    ColumnSpacing="2"
                                                    RowDefinitions="Auto,Auto">
                                                    <Ellipse
                                                        Width="5"
                                                        Height="5"
                                                        VerticalAlignment="Center"
                                                        Fill="{StaticResource BrushSuccess}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        FontSize="{StaticResource FontSizeSmall}"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource BrushTextSecondary}"
                                                        Text="{l10n:Localize LookAheadTime}" />
                                                    <TextBox
                                                        Grid.RowSpan="2"
                                                        Grid.Column="2"
                                                        Width="48"
                                                        MinHeight="30"
                                                        Padding="0"
                                                        VerticalContentAlignment="Center"
                                                        Background="{StaticResource BrushBgInput}"
                                                        BorderBrush="{StaticResource BrushBorderDefault}"
                                                        BorderThickness="1"
                                                        Classes="param"
                                                        FontFamily="{StaticResource FontMono}"
                                                        FontSize="{StaticResource FontSizeBase}"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource TextAccentSecondary}"
                                                        KeyDown="OnLookAheadKeyDown"
                                                        LostFocus="OnLookAheadLostFocus"
                                                        Text="{Binding LookAheadTimeMs, Mode=OneWay, Converter={StaticResource DynamicNumberFormatConverter}}"
                                                        TextAlignment="Center" />
                                                    <TextBlock
                                                        Grid.RowSpan="2"
                                                        Grid.Column="3"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        FontSize="{StaticResource FontSizeXS}"
                                                        Foreground="{StaticResource BrushSuccess}"
                                                        Text="ms" />

                                                    <StackPanel
                                                        Grid.Row="1"
                                                        Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        Spacing="4">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="{StaticResource FontSizeTiny}"
                                                            Foreground="{StaticResource BrushTextMuted}"
                                                            Text="{l10n:Localize RangeOf}" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="{StaticResource FontSizeTiny}"
                                                            Foreground="{StaticResource BrushTextMuted}"
                                                            Text="{Binding MinLookAheadTimeMs, Converter={StaticResource DynamicNumberFormatConverter}}" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="{StaticResource FontSizeTiny}"
                                                            Foreground="{StaticResource BrushTextMuted}"
                                                            Text="{l10n:Localize To}" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="{StaticResource FontSizeTiny}"
                                                            Foreground="{StaticResource BrushTextMuted}"
                                                            Text="{Binding MaxLookAheadTimeMs, Converter={StaticResource DynamicNumberFormatConverter}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!--<Border
                                            Padding="12,10"
                                            Background="{StaticResource Border_bg_degrade2}"
                                            BorderBrush="{StaticResource BrushBorderSubtle}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                            <StackPanel Spacing="12" Margin="0,10">

                                        -->
                                        <!--  Fila: True Peak Ceiling  -->
                                        <!--
                                                <Grid
                                                    ColumnDefinitions="6,*,Auto,30"
                                                    ColumnSpacing="8">
                                                    <Ellipse
                                                        Width="5"
                                                        Height="5"
                                                        VerticalAlignment="Center"
                                                        Fill="{StaticResource BrushAccentSkyblue}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        FontSize="{StaticResource FontSizeSmall}"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource BrushTextSecondary}"
                                                        Text="{l10n:Localize TruePeakCeiling}" />
                                                    <TextBox
                                                        Grid.Column="2"
                                                        Width="50"
                                                        MinHeight="28"
                                                        Padding="0"
                                                        VerticalContentAlignment="Center"
                                                        Background="{StaticResource BrushBgInput}"
                                                        BorderBrush="{StaticResource BrushBorderDefault}"
                                                        BorderThickness="1"
                                                        Classes="param"
                                                        FontFamily="{StaticResource FontMono}"
                                                        FontSize="{StaticResource FontSizeBase}"
