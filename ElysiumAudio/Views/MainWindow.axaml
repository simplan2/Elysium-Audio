<Window
    x:Class="ElysiumAudio.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Avalonia.Controls"
    xmlns:conv="using:ElysiumAudio.Converters"
    xmlns:customControls="using:ElysiumAudio.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ElysiumAudio.Models"
    xmlns:netDataGrid="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
    xmlns:vm="using:ElysiumAudio.ViewModels"
    Title="Elysium Audio"
    Width="1200"
    Height="748"
    MinWidth="1024"
    MinHeight="640"
    d:DesignHeight="720"
    d:DesignWidth="1180"
    x:DataType="vm:MainWindowViewModel"
    Background="{StaticResource BrushBgBase}"
    Foreground="{StaticResource BrushTextPrimary}"
    Icon="/Assets/avalonia-logo.ico"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.Resources>
        <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
        <conv:DynamicNumberFormatConverter x:Key="DynamicNumberFormatConverter" />
    </Window.Resources>

    <Grid Margin="20" RowDefinitions="Auto, *, Auto">

        <!--
            ==========================================================
            HEADER
            ==========================================================
        -->
        <Grid
            Grid.Row="0"
            Margin="0,0,0,14"
            VerticalAlignment="Center"
            ColumnDefinitions="*, 368"
            ColumnSpacing="16">

            <!--  Botones de Acción  -->
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
				
                <Button Classes="accent" Command="{Binding AddFileCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock VerticalAlignment="Center" FontSize="14">＋</TextBlock>
                        <TextBlock VerticalAlignment="Center">Add Files</TextBlock>
                    </StackPanel>
                </Button>
				
				<Button Classes="ghost" Command="{Binding AddDirectoryCommand}">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<Path
                            Width="16"
                            Height="16"
                            VerticalAlignment="Center"
                            Data="M3,3 L8,3 L10,5 L15,5 L15,13 L3,13 Z"
                            Stroke="{StaticResource BrushTextSecondary}"
                            StrokeThickness="1.6" />
						<TextBlock VerticalAlignment="Center">Add Dir</TextBlock>
					</StackPanel>
				</Button>
				
                <Button Classes="ghost" Command="{Binding ClearListCommand}">
                    <TextBlock VerticalAlignment="Center">Clear List</TextBlock>
                </Button>

            </StackPanel>

            <!--  Enlace a Configuraciones avanzadas  -->
            <Grid
                Grid.Column="1"
                Margin="0,0,10,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                ColumnDefinitions="*, Auto">

                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
                    <TextBlock
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="{StaticResource BrushTextPrimary}"
                        Text="Settings" />

                </StackPanel>

            </Grid>
        </Grid>

        <!--
            ==========================================================
            CUERPO PRINCIPAL
            Columna izquierda: controles de masterización
            Columna derecha: tabla de archivos
            ==========================================================
        -->
        <Grid
            Grid.Row="1"
            ColumnDefinitions="*, 368"
            ColumnSpacing="16">

            <!--  ***************** ZONA IZQUIERDO: COLA DE ARCHIVOS *****************  -->
            <Grid
                Grid.Column="0"
                RowDefinitions="*, 80"
                RowSpacing="16">


                <!--  Zona de arrastre con el DataGrid  -->
                <Border
                    Name="DropZoneBorder"
                    Grid.Row="0"
                    Background="{StaticResource BrushBgPanel}"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    ClipToBounds="True"
                    CornerRadius="12"
                    DragDrop.AllowDrop="True">

                    <Grid>
                        <DataGrid
                            AutoGenerateColumns="False"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CanUserReorderColumns="True"
                            CanUserResizeColumns="True"
                            ColumnHeaderHeight="52"
                            CornerRadius="12"
                            GridLinesVisibility="Horizontal"
                            IsReadOnly="True"
                            ItemsSource="{Binding AudioFiles}"
                            RowHeight="60">

                            <DataGrid.Styles>
                                <!--  Texto general  -->
                                <Style Selector="TextBlock">
                                    <Setter Property="Foreground" Value="#E0E0E0" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="FontSize" Value="13" />
                                </Style>

                                <!--  Encabezados  -->
                                <Style Selector="DataGridColumnHeader">
                                    <Setter Property="Template">
                                        <ControlTemplate>
                                            <Border
                                                Background="#11131A"
                                                BorderBrush="Transparent"
                                                BorderThickness="0">
                                                <ContentPresenter
                                                    Margin="0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    RecognizesAccessKey="True" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter>
                                </Style>

                                <Style Selector="DataGridColumnHeader TextBlock">
                                    <Setter Property="TextAlignment" Value="Center" />
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="MaxLines" Value="2" />
                                </Style>

                                <!--  Fila normal  -->
                                <Style Selector="DataGridRow">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                </Style>

                                <!--  Fila seleccionada  -->
                                <Style Selector="DataGridRow:selected">
                                    <Setter Property="Background" Value="#1E2022" />
                                    <!--  azul tenue  -->
                                    <Setter Property="BorderBrush" Value="#00AFFF" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                </Style>

                                <!--  Fila con foco  -->
                                <Style Selector="DataGridRow:focus">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0,0,0,0" />
                                </Style>

                                <!--  Celdas  -->
                                <Style Selector="DataGridCell">
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0,0,0,0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="FocusAdorner" Value="{x:Null}" />
                                    <Setter Property="Focusable" Value="False" />

                                </Style>

                                <!--  Celda con foco  -->
                                <Style Selector="DataGridCell:focus">
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="FocusAdorner" Value="{x:Null}" />

                                    <Setter Property="Focusable" Value="False" />
                                </Style>
                            </DataGrid.Styles>

                            <!--  Columnas  -->
                            <DataGrid.Columns>
                                <DataGridTemplateColumn
                                    Width="0.5*"
                                    MinWidth="60"
                                    Header="#">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:AudioFileModel">
                                            <customControls:AudioStatusIndicator
                                                Width="32"
                                                Height="32"
                                                HorizontalAlignment="Center"
                                                Status="{Binding Status}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn
                                    Width="2*"
                                    MinWidth="120"
                                    Binding="{Binding FileName}"
                                    Header="File Name" />
                                <DataGridTextColumn
                                    Width="*"
                                    MinWidth="98"
                                    Binding="{Binding Codec}"
                                    Header="Codec" />
                                <DataGridTextColumn
                                    Width="*"
                                    MinWidth="108"
                                    Binding="{Binding Duration}"
                                    Header="Duration" />
                                <DataGridTextColumn
                                    Width="*"
                                    MinWidth="98"
                                    Binding="{Binding Loudness}"
                                    Header="LUFS" />
                                <DataGridTextColumn
                                    Width="*"
                                    MinWidth="98"
                                    Binding="{Binding NormalizedLoudness}"
                                    Header="Norm.&#x0a;LUFS" />
                                <DataGridTextColumn
                                    Width="*"
                                    MinWidth="98"
                                    Binding="{Binding Peak}"
                                    Header="Peak" />
                                <DataGridTextColumn
                                    Width="*"
                                    MinWidth="98"
                                    Binding="{Binding NormalizedPeak}"
                                    Header="Norm.&#x0a;Peak" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!--  Borde del Grid  -->
                        <Border
                            Background="Transparent"
                            BorderBrush="{StaticResource BrushBorderDefault}"
                            BorderThickness="1"
                            CornerRadius="12"
                            IsHitTestVisible="False" />

                        <!--  Mensaje de arrastre de archivos  -->
                        <TextBlock
                            Margin="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="Medium"
                            Foreground="{StaticResource BrushTextMuted}"
                            IsVisible="{Binding AudioFiles.Count, Converter={StaticResource CountToVisibilityConverter}}"
                            Text="Drop WAV / FLAC here or use Add Files" />

                    </Grid>
                </Border>

                <Border
                    Grid.Row="1"
                    Padding="16,10"
                    Background="{StaticResource BrushBgPanel}"
                    BorderBrush="{StaticResource BrushBorderDefault}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <Grid ColumnDefinitions="1.2*,16,2.0*,16,1*">

                        <!--  Formato de salida  -->
                        <Button
                            x:Name="FormatButton"
                            HorizontalAlignment="Stretch"
                            Background="{StaticResource BrushBgPanelAlt}"
                            Classes="ghost"
                            Command="{Binding TogglePopupCommand}">
                            <Button.Flyout>
                                <Flyout
                                    IsOpen="{Binding IsFlyoutOpen}"
                                    Placement="Bottom"
                                    ShowMode="Standard"
									Closed="OnFlyoutClosed">

                                    <ListBox MinWidth="200"
                                        Background="{StaticResource BrushBgPanelAlt}"
                                        Classes="dark-popup"
                                        ItemsSource="{Binding OutputFormatOptions}"
                                        SelectedItem="{Binding SelectedFormat}"
                                        SelectionMode="Single">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    Margin="20,0" VerticalAlignment="Center" FontSize="12"
                                                    Text="{Binding}" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Flyout>
                            </Button.Flyout>

                            <StackPanel Spacing="4">
                                <TextBlock
                                    FontSize="10.5"
                                    Foreground="{StaticResource BrushTextMuted}"
                                    Text="OUTPUT FORMAT" />
                                <TextBlock
                                    FontSize="11.5"
                                    Foreground="{StaticResource BrushTextSecondary}"
                                    Text="{Binding SelectedFormat}" />
                            </StackPanel>
                        </Button>



                        <!--  Directorio de salida  -->
                        <Border
                            Grid.Column="2"
                            Height="50"
                            VerticalAlignment="Center"
                            Background="{StaticResource BrushBgPanelAlt}"
                            BorderBrush="{StaticResource BrushBorderSubtle}"
                            BorderThickness="0"
                            CornerRadius="8">

                            <Button
                                HorizontalAlignment="Stretch"
                                Background="{StaticResource BrushBgPanelAlt}"
                                BorderBrush="{StaticResource BrushBorderSubtle}"
                                Classes="ghost"
                                Command="{Binding SelectOutputDirectoryCommand}">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        FontSize="10.5"
                                        Foreground="{StaticResource BrushTextMuted}"
                                        Text="OUTPUT DIRECTORY" />
                                    <TextBlock
                                        FontSize="11.5"
                                        Foreground="{StaticResource BrushTextSecondary}"
                                        Text="{Binding OutputDirectory}"
                                        TextWrapping="NoWrap" />
                                </StackPanel>
                            </Button>
                        </Border>

                        <!--  Explorar Directorio  -->
                        <Border
                            Grid.Column="4"
                            Height="50"
                            VerticalAlignment="Center"
                            Background="{StaticResource BrushBgPanelAlt}"
                            BorderBrush="{StaticResource BrushBorderSubtle}"
                            BorderThickness="0"
                            CornerRadius="8">
                            <Button
                                Height="50"
                                HorizontalAlignment="Stretch"
                                Background="{StaticResource BrushBgPanelAlt}"
                                BorderBrush="{StaticResource BrushBorderSubtle}"
                                Classes="ghost"
                                Command="{Binding ExploreOutputDirectoryCommand}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="10.5"
                                    Foreground="{StaticResource BrushTextMuted}"
                                    Text="EXPLORE DIRECTORY"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </Button>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!--  ***************** PANEL DERECHO: CONTROLES *****************  -->
            <Border
                Grid.Column="1"
                Background="{StaticResource BrushBgPanel}"
                BorderBrush="{StaticResource BrushBorderDefault}"
                BorderThickness="1"
                CornerRadius="12"
                Focusable="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20,24" RowDefinitions="Auto, Auto, Auto, 20, Auto, *, 48">

                        <!--  1. DSP / Loudness Calibration  -->
                        <Grid
                            Grid.Row="0"
                            VerticalAlignment="Center"
                            RowDefinitions="Auto, Auto">
                            <TextBlock
                                Grid.Row="0"
                                Margin="4,0"
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="{StaticResource BrushTextPrimary}">
                                <Run
                                    FontWeight="Bold"
                                    Foreground="{StaticResource BrushAccent}"
                                    Text="DSP" />
                                <Run Text=" · Loudness Calibration" />
                            </TextBlock>
                        </Grid>

                        <!--  1. Presets de normalización por plataforma  -->
                        <ComboBox
                            Grid.Row="1"
                            Margin="0,16,0,16"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            ItemsSource="{Binding Presets}"
                            SelectedItem="{Binding SelectedPreset}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Foreground="{StaticResource BrushTextPrimary}" Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!--  2. Controles  -->
                        <Grid Grid.Row="2" RowDefinitions="64,64,64,64">

                            <!--  1. Target Loudness  -->
                            <Grid Grid.Row="0">
                                <Grid
                                    Grid.Row="0"
                                    VerticalAlignment="Stretch"
                                    RowDefinitions="22,*">

                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="Medium"
                                            Foreground="{StaticResource BrushTextSecondary}"
                                            Text="Target Loudness" />
                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <TextBox
                                                Width="46"
                                                Height="20"
                                                MinWidth="46"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                Classes="param"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource BrushAccent}"
                                                KeyDown="OnTargetLufsKeyDown"
                                                LostFocus="OnTargetLufsLostFocus"
                                                Text="{Binding TargetLufs, Mode=OneWay, Converter={StaticResource DynamicNumberFormatConverter}}"
                                                TextAlignment="Center" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{StaticResource BrushTextMuted}"
                                                Text="LUFS" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <Grid Grid.Row="1" RowDefinitions="14,*">
                                    <Grid Grid.Row="1" ColumnDefinitions="26, *, 26">
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontSize="10.5"
                                            Foreground="{StaticResource BrushTextMuted}"
                                            Text="{Binding MinTargetLufs, Converter={StaticResource DynamicNumberFormatConverter}}" />
                                        <Slider
                                            Grid.Column="1"
                                            Classes="active-accent"
                                            Maximum="-6.0"
                                            Minimum="-24.0"
                                            TickFrequency="0.1"
                                            Value="{Binding TargetLufs}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontSize="10.5"
                                            Foreground="{StaticResource BrushTextMuted}"
                                            Text="{Binding MaxTargetLufs, Converter={StaticResource DynamicNumberFormatConverter}}" />
                                    </Grid>
                                </Grid>
                            </Grid>

                            <!--  2. True Peak Ceiling  -->
                            <Grid Grid.Row="1">
                                <Grid
                                    Grid.Row="0"
                                    VerticalAlignment="Stretch"
                                    RowDefinitions="22,*">

                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="Medium"
                                            Foreground="{StaticResource BrushTextSecondary}"
                                            Text="True Peak Ceiling" />
                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <TextBox
                                                Width="46"
                                                Height="24"
                                                MinWidth="46"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                Classes="param"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource BrushInfo}"
                                                KeyDown="OnTruePeakKeyDown"
                                                LostFocus="OnTruePeakLostFocus"
                                                Text="{Binding TruePeakCeiling, Mode=OneWay, Converter={StaticResource DynamicNumberFormatConverter}}"
                                                TextAlignment="Center" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{StaticResource BrushTextMuted}"
                                                Text="dBTP" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <Grid Grid.Row="1" RowDefinitions="14,*">
                                    <Grid Grid.Row="1" ColumnDefinitions="26, *, 26">
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontSize="10.5"
                                            Foreground="{StaticResource BrushTextMuted}"
                                            Text="{Binding MinPeakCeiling, Converter={StaticResource DynamicNumberFormatConverter}}" />
                                        <Slider
                                            Grid.Column="1"
                                            Classes="active-teal"
                                            Maximum="-0.1"
                                            Minimum="-3.0"
                                            TickFrequency="0.1"
                                            Value="{Binding TruePeakCeiling}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontSize="10.5"
                                            Foreground="{StaticResource BrushTextMuted}"
                                            Text="{Binding MaxPeakCeiling, Converter={StaticResource DynamicNumberFormatConverter}}" />
                                    </Grid>
                                </Grid>
                            </Grid>

                            <!--  3. Release Time  -->
                            <Grid Grid.Row="2">
                                <Grid
                                    Grid.Row="0"
                                    VerticalAlignment="Stretch"
                                    RowDefinitions="22,*">

                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="Medium"
                                            Foreground="{StaticResource BrushTextSecondary}"
                                            Text="Release Time" />
                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <TextBox
                                                Name="ReleaseTimeMsInput"
                                                Width="46"
                                                Height="24"
                                                MinWidth="46"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                Classes="param"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource BrushWarning}"
                                                KeyDown="OnReleaseTimeMsKeyDown"
                                                LostFocus="OnReleaseTimeMsLostFocus"
                                                Text="{Binding ReleaseTimeMs, Mode=OneWay, Converter={StaticResource DynamicNumberFormatConverter}}"
                                                TextAlignment="Center" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{StaticResource BrushTextMuted}"
                                                Text="ms" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <Grid Grid.Row="1" RowDefinitions="14,*">
                                    <Grid Grid.Row="1" ColumnDefinitions="26, *, 26">
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontSize="10.5"
                                            Foreground="{StaticResource BrushTextMuted}"
                                            Text="{Binding MinReleaseTimeMs, Converter={StaticResource DynamicNumberFormatConverter}}" />
                                        <Slider
                                            Grid.Column="1"
                                            Classes="active-amber"
                                            IsSnapToTickEnabled="True"
                                            Maximum="200"
                                            Minimum="20"
                                            TickFrequency="0.1"
                                            Value="{Binding ReleaseTimeMs}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontSize="10.5"
                                            Foreground="{StaticResource BrushTextMuted}"
                                            Text="{Binding MaxReleaseTimeMs, Converter={StaticResource DynamicNumberFormatConverter}}" />
                                    </Grid>
                                </Grid>
                            </Grid>

                            <!--  4. Look-ahead Time  -->
                            <Grid Grid.Row="3">
                                <Grid
                                    Grid.Row="0"
                                    VerticalAlignment="Stretch"
                                    RowDefinitions="22,*">

                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="Medium"
                                            Foreground="{StaticResource BrushTextSecondary}"
                                            Text="Look-ahead Time" />
                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <TextBox
                                                Name="LookAheadInput"
                                                Width="46"
                                                Height="24"
                                                MinWidth="46"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                Classes="param"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource BrushSuccess}"
                                                KeyDown="OnLookAheadKeyDown"
                                                LostFocus="OnLookAheadLostFocus"
                                                Text="{Binding LookAheadTimeMs, Mode=OneWay, Converter={StaticResource DynamicNumberFormatConverter}}"
                                                TextAlignment="Center" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{StaticResource BrushTextMuted}"
                                                Text="ms" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <Grid Grid.Row="1" RowDefinitions="14,*">
                                    <Grid Grid.Row="1" ColumnDefinitions="26, *, 26">
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontSize="10.5"
                                            Foreground="{StaticResource BrushTextMuted}"
                                            Text="{Binding MinLookAheadTimeMs, Converter={StaticResource DynamicNumberFormatConverter}}" />
                                        <Slider
                                            Grid.Column="1"
                                            Classes="active-green"
                                            IsSnapToTickEnabled="True"
                                            Maximum="10"
                                            Minimum="1"
                                            TickFrequency="0.1"
                                            Value="{Binding LookAheadTimeMs}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontSize="10.5"
                                            Foreground="{StaticResource BrushTextMuted}"
                                            Text="{Binding MaxLookAheadTimeMs, Converter={StaticResource DynamicNumberFormatConverter}}" />
                                    </Grid>
                                </Grid>
                            </Grid>

                            <Grid Grid.Row="1" />
                        </Grid>

                        <!--  Separador  -->
                        <Rectangle
                            Grid.Row="3"
                            Height="1"
                            VerticalAlignment="Center"
                            Fill="{StaticResource BrushBorderSubtle}" />

                        <!--  3. Execution & Safety  -->
                        <StackPanel
                            Grid.Row="4"
                            Margin="0,8,0,0"
                            Spacing="14">

                            <TextBlock
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="{StaticResource BrushTextPrimary}">
                                <Run
                                    FontWeight="Bold"
                                    Foreground="{StaticResource BrushAccentTeal}"
                                    Text="Execution" />
                                <Run Text=" · Safety" />
                            </TextBlock>

                            <!--  Preservar Metadatos  -->
                            <CheckBox
                                Content="Preserve Metadata (ID3v2.3)"
                                Foreground="{StaticResource BrushTextSecondary}"
                                IsChecked="True" />




                        </StackPanel>

                        <!--  4. Botón principal de ejecución  -->
                        <Button
                            Grid.Row="6"
                            Height="44"
                            HorizontalAlignment="Stretch"
                            Classes="success"
                            Command="{Binding StartNormalizationCommand}">
                            <StackPanel
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Foreground="White"
                                    Text="▶" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Text="Run Batch Normalization" />
                            </StackPanel>
                        </Button>

                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <!--
            ==========================================================
            BARRA DE ESTADO GLOBAL
            ==========================================================
        -->
        <Border
            Grid.Row="2"
            Margin="0,14,0,0"
            Padding="12,7"
            Background="{StaticResource BrushBgPanel}"
            BorderBrush="{StaticResource BrushBorderDefault}"
            BorderThickness="1"
            CornerRadius="8">
            <TextBlock
                VerticalAlignment="Center"
                FontFamily="Consolas,Monospace"
                FontSize="11.5"
                Foreground="{StaticResource BrushSuccess}"
                Text="{Binding SystemStatus}" />
        </Border>

    </Grid>
</Window>
