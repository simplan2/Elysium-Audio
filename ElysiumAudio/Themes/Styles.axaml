<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        =====================================================================
        ESTILOS GLOBALES DE ELYSIUM AUDIO
        Sobrescriben partes del tema Fluent con el look dark profesional.
        =====================================================================
    -->

    <!--  ============================= BUTTON =============================  -->
    <Style Selector="Button">
        <Setter Property="Background" Value="{StaticResource BrushBgElevated}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderDefault}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrushBgPanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}" />
    </Style>

    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrushBorderDefault}" />
    </Style>

    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!--  Variantes de botones: primario y fantasma  -->
    <Style Selector="Button.main2">
        <Setter Property="Background" Value="{StaticResource btn_bg_degrade}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBgInput}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextOnAccent}" />
    </Style>
    <!--<Style Selector="Button.main /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrushAccent}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderAccent}" />
    </Style>-->
    <Style Selector="Button.main2:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrushAccentHover}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderAccent}" />
    </Style>
    <Style Selector="Button.main2:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrushAccentPress}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderAccent}" />
    </Style>

    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderDefault}" />
        <Setter Property="Padding" Value="14,8" />
    </Style>

    <!--  ============================= Button Neon =============================  -->
	<Style Selector="Button.main">
		<!-- Usamos tu color de fondo base para botones -->
		<Setter Property="Background" Value="{StaticResource ButtonNeonBackground}"/>
		<Setter Property="Foreground" Value="{StaticResource ButtonNeonBorder}"/>
		<Setter Property="FontSize" Value="13" />
		<Setter Property="HorizontalContentAlignment" Value="Center"/>
		<Setter Property="VerticalContentAlignment" Value="Center"/>
		<Setter Property="CornerRadius" Value="10"/>
		<Setter Property="Padding" Value="24,12"/>
		<Setter Property="Focusable" Value="False"/>
		<Setter Property="Template">
			<ControlTemplate>
				<!-- 1. Marco exterior con tu borde por defecto -->
				<Border Background="{TemplateBinding Background}"
						BorderBrush="{StaticResource BorderDefault}"
						BorderThickness="1"
						CornerRadius="{TemplateBinding CornerRadius}">

					<Panel>
						<!-- 2. Resplandor central adaptado con tu color AccentPrimary (#1BA6FA) -->
						<Border CornerRadius="{TemplateBinding CornerRadius}" Margin="1">
							<Border.Background>
								<RadialGradientBrush Center="50%,50%" RadiusX="0.9" RadiusY="0.9">
									<!-- Nota: Usamos variaciones de opacidad sobre tu AccentPrimary -->
									<GradientStop Color="#331BA6FA" Offset="0.0"/>
									<GradientStop Color="#0A1BA6FA" Offset="0.6"/>
									<GradientStop Color="#001BA6FA" Offset="1.0"/>
								</RadialGradientBrush>
							</Border.Background>
						</Border>

						<!-- 3. Borde interior brillante usando tu AccentPrimary -->
						<Border Margin="3"
								BorderBrush="{StaticResource ButtonNeonBorder}"
								Background="Transparent"
								BorderThickness="1.5"
								CornerRadius="7"/>

						<!-- 4. Contenido del botón limpio y transparente -->
						<ContentPresenter Background="Transparent"
										  BorderBrush="Transparent"
										  IsHitTestVisible="False"
										  Content="{TemplateBinding Content}"
										  ContentTemplate="{TemplateBinding ContentTemplate}"
										  Foreground="{TemplateBinding Foreground}"
										  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
										  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
										  Margin="{TemplateBinding Padding}"/>
					</Panel>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>

	<!-- Estados Interactivos vinculados a tus superficies y acentos de hover/press -->
	<Style Selector="Button.main:pointerover">
		<Setter Property="Background" Value="{StaticResource ButtonNeonHoverBackground}"/>
		<Setter Property="Foreground" Value="{StaticResource ButtonNeonForegroundHover}"/>
	</Style>

	<Style Selector="Button.main:pressed">
		<Setter Property="Background" Value="{StaticResource ButtonNeonPressedBackground}"/>
		<Setter Property="Foreground" Value="{StaticResource AccentPrimary}"/>
		<Setter Property="RenderTransform" Value="Scale(0.98)"/>
	</Style>

    <!--  ============================= SPLIT =============================  -->

    <Style Selector="SplitButton.queue">
        <Setter Property="Background" Value="{StaticResource BrushBgPanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Foreground" Value="{StaticResource TextAccentSecondary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMedium}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="14,8,12,8" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="PART_RootBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                    <Grid ColumnDefinitions="*,Auto,Auto">

                        <!--  Mitad principal: dispara el Command del SplitButton.  -->
                        <Button
                            Name="PART_PrimaryButton"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="8,0,0,8"
                            FontSize="{TemplateBinding FontSize}"
                            FontWeight="{TemplateBinding FontWeight}"
                            Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter
                                Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Button>

                        <!--  Separador vertical, con la misma métrica de la familia.  -->
                        <Border
                            Name="SeparatorBorder"
                            Grid.Column="1"
                            Width="0.8"
                            Margin="0,5"
                            Background="Transparent" />

                        <!--  Mitad del desplegable: abre el Flyout.  -->
                        <Button
                            Name="PART_SecondaryButton"
                            Grid.Column="2"
                            Width="28"
                            Padding="0"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="0,8,8,0"
                            FontSize="{TemplateBinding FontSize}"
                            Foreground="{TemplateBinding Foreground}">

                            <Path
                                Width="8"
                                Height="4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="M0,0 L4,4 L8,0"
                                Fill="Transparent"
                                Stretch="None"
                                Stroke="{TemplateBinding Foreground}"
                                StrokeJoin="Round"
                                StrokeLineCap="Round"
                                StrokeThickness="1.5" />
                        </Button>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!--  Estilo global para los menús desplegables de las colas  -->
    <Style Selector="MenuFlyoutPresenter.queue-flyout">
        <Setter Property="Background" Value="{StaticResource BrushBgOverlay}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="6" />
    </Style>

    <!--  Estilo opcional para los elementos individuales (MenuItems) dentro del menú  -->
    <Style Selector="MenuFlyoutPresenter.queue-flyout MenuItem">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeLarge}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="Padding" Value="20,8" />
    </Style>


    <Style Selector="MenuFlyoutPresenter.queue-flyout MenuItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{StaticResource BrushBgElevated}" />
    </Style>
    <Style Selector="MenuFlyoutPresenter.queue-flyout MenuItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{StaticResource BrushAccentDim}" />
    </Style>
    <Style Selector="MenuFlyoutPresenter.queue-flyout MenuItem:selected:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{StaticResource BrushAccentDim}" />
    </Style>


    <!--
        Estados: se cambian las propiedades del propio SplitButton y el
        TemplateBinding las propaga al Border raíz, que ya tiene la transición.
    -->
    <Style Selector="SplitButton.queue:pointerover">
        <Setter Property="Background" Value="{StaticResource BrushBgElevated}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}" />
        <Setter Property="Foreground" Value="{StaticResource TextAccentSecondary}" />
    </Style>

    <Style Selector="SplitButton.queue:pressed">
        <Setter Property="Background" Value="{StaticResource BrushBgPanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}" />
    </Style>

    <!--  Al enfocar la mitad secundaria se resalta el borde del control completo.  -->
    <Style Selector="SplitButton.queue:focus-visible /template/ Border#PART_RootBorder">
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>


    <Style Selector="Button.ghostNoZoom">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderDefault}" />
        <Setter Property="Transitions" Value="{x:Null}" />
    </Style>

    <Style Selector="Button.ghostNoZoom:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrushBgElevated}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}" />
    </Style>


    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrushBgPanelAlt}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}" />
    </Style>

    <!--  Selector segmentado de propósito (Normalize / Analyze)  -->
    <Style Selector="Button.segment">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="14,9" />
    </Style>
    <Style Selector="Button.segment:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrushBgPanelAlt}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.segment.active">
        <Setter Property="Background" Value="{StaticResource bg_degrade}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderAccent}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>
    <Style Selector="Button.segment.active /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource bg_degrade}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderAccent}" />
    </Style>
    <Style Selector="Button.segment.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource bg_degrade}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderAccent}" />
    </Style>

    <!--  Botones stepper estilo plugin VST  -->
    <Style Selector="Button.step">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="38" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{StaticResource BrushBgButton}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderDefault}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeXL}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
    </Style>
    <Style Selector="Button.step:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrushBgElevated}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}" />
    </Style>
    <Style Selector="Button.step:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrushAccentDim}" />
    </Style>
    <Style Selector="Button.step.big">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeDisplay}" />
    </Style>

    <!--  ============================= TEXTBOX =============================  -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{StaticResource BrushBgInput}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderDefault}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="CaretBrush" Value="{StaticResource BrushAccent}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}" />
    </Style>

    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
    </Style>

    <Style Selector="TextBox:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>
    <!--  TextBox "invisible" dentro de los paneles de parámetros  -->
    <Style Selector="TextBox.param">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="1,0" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.param:focus /template/ TextPresenter">
        <Setter Property="TextBlock.Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>
    <!--  ============================= SLIDER =============================  -->

    <!--  Hover  -->
    <!--<Style Selector="Slider.modern-slider:pointerover /template/ Thumb#PART_Thumb">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
    </Style>-->


    <!--  Presionado  -->
    <!--<Style Selector="Slider.modern-slider:pressed /template/ Thumb#PART_Thumb">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
    </Style>-->

    <!--  Color del tramo activo (parte rellenada hasta el thumb)  -->
    <Style Selector="Slider.active-accent /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="{StaticResource BrushAccentSkyblue}" />
    </Style>
    <Style Selector="Slider.active-accent /template/ Thumb">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Background" Value="{StaticResource BrushBgControl}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBgControl}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Slider.active-second /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="{StaticResource BrushAccentSkyblue}" />
    </Style>
    <Style Selector="Slider.active-second /template/ Thumb">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Background" Value="{StaticResource BrushAccentSkyblue}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccentSkyblue}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Slider.active-amber /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="{StaticResource BrushAccentRosa}" />
    </Style>
    <Style Selector="Slider.active-amber /template/ Thumb">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Background" Value="{StaticResource BrushAccentRosa}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccentRosa}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Slider.active-green /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="{StaticResource BrushSuccess}" />
    </Style>
    <Style Selector="Slider.active-green /template/ Thumb">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Background" Value="{StaticResource BrushSuccess}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushSuccess}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!--  ============================= COMBOBOX =============================  -->
    <!--  Selector de presets: fondo oscuro consistente con la paleta  -->
    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{StaticResource BrushBgInput}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderDefault}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="ComboBox:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}" />
    </Style>
    <Style Selector="ComboBox:focus /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeLG}" />
        <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrushBgElevated}" />
    </Style>
    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrushAccentDim}" />
    </Style>
    <Style Selector="ComboBoxItem:selected /template/ TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>

    <!--  ============================= CHECKBOX =============================  -->
    <Style Selector="CheckBox">
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Margin="2" ColumnDefinitions="Auto,Auto">
                    <!--  El cuadro del check  -->
                    <Border
                        x:Name="PART_Box"
                        Width="16"
                        Height="16"
                        Background="Transparent"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1.4"
                        CornerRadius="3"
                        DockPanel.Dock="Left">
                        <Viewbox
                            Width="11"
                            Height="11"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <!--  La marca de verificación  -->
                            <Path
                                x:Name="PART_CheckMark"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="M 2,8 L 6,12 L 14,3"
                                IsVisible="False"
                                Stroke="White"
                                StrokeLineCap="Round"
                                StrokeThickness="2" />
                        </Viewbox>

                    </Border>

                    <!--  EL CONTENIDO (texto)  -->
                    <ContentPresenter
                        Grid.Column="1"
                        Margin="7,0,0,0"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding Content}"
                        Foreground="{TemplateBinding Foreground}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="CheckBox:pointerover /template/ Border#PART_Box">
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}" />
    </Style>

    <Style Selector="CheckBox:checked /template/ Border#PART_Box">
        <Setter Property="Background" Value="{StaticResource BrushAccentDim}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
    </Style>

    <Style Selector="CheckBox:checked:pointerover /template/ Border#PART_Box">
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccentHover}" />
    </Style>

    <Style Selector="CheckBox:checked /template/ Path#PART_CheckMark">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="CheckBox:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!--  Barra de estado: verde "success" solo cuando el lote se completó sin errores  -->
    <Style Selector="Border.ok > Ellipse">
        <Setter Property="Fill" Value="{StaticResource BrushSuccess}" />
    </Style>
    <Style Selector="Border.ok TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
    </Style>

    <!--  ============================= TOGGLESWITCH =============================  -->
    <Style Selector="ToggleSwitch">
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
    </Style>

    <!--  ============================= DATAGRID =============================  -->
    <Style Selector="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeLG}" />
    </Style>

    <Style Selector="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource BrushBgPanelAlt}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMD}" />
    </Style>

    <!--
        Las cabeceras son el unico sitio donde una traduccion larga puede no caber: las
        celdas ya traian TextTrimming propio. Con columnas Width="*" solo se recorta si
        la ventana esta en su MinWidth, pero cuando ocurre se cortaba a pelo y se
        derramaba sobre la columna vecina. Con puntos suspensivos al menos se degrada
        limpio, y el ToolTip deja el texto completo disponible.
    -->
    <Style Selector="DataGridColumnHeader TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="ToolTip.Tip">
            <Setter.Value>
                <Binding Path="Text" RelativeSource="{RelativeSource Self}" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="DataGridCell">
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  ============================= ListBox Popup =============================  -->
    <Style Selector="ListBox.dark-popup">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style Selector="ListBox.dark-popup ListBoxItem">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter
                        Margin="{TemplateBinding Padding}"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Height" Value="38" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="ListBox.dark-popup ListBoxItem:pointerover">
        <Setter Property="Background" Value="{StaticResource BrushBgElevated}" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="ListBox.dark-popup ListBoxItem:selected">
        <Setter Property="Background" Value="{StaticResource BrushAccentDim}" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="ListBox.dark-popup ListBoxItem:selected:pointerover">
        <Setter Property="Background" Value="{StaticResource BrushAccentDim}" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="FlyoutPresenter">
        <Setter Property="Background" Value="{StaticResource BrushBgOverlay}" />
        <Setter Property="Padding" Value="0,6" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}" />
    </Style>


    <!--  Slider fade audio  -->
    <Style Selector="Slider.audioFader">
        <Setter Property="Orientation" Value="Vertical" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="MinHeight" Value="250" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!--  2. Arreglo definitivo del Riel de Incremento (El tramo superior: debe ser invisible/oscuro)  -->
    <Style Selector="Slider.AudioFader /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="Background" Value="#14181F" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!--  3. Arreglo definitivo del Riel de Decremento (El tramo inferior: el Neón Azul que sube)  -->
    <Style Selector="Slider.AudioFader /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="#00A2FF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!--  4. Diseño del Botón de Arrastre (Thumb Metálico con indicador azul)  -->
    <Style Selector="Slider.AudioFader /template/ Thumb">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="38" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <!--  Contenedor en capas para el botón físico sin romper el Hit-Test  -->
                <Grid>
                    <!--  Cuerpo de metal con degradado y sombra de caída  -->
                    <Border
                        BorderBrush="#111111"
                        BorderThickness="1"
                        BoxShadow="0 4 6 0 #80000000"
                        CornerRadius="5">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                <GradientStop Offset="0.0" Color="#737A85" />
                                <GradientStop Offset="0.3" Color="#4A5059" />
                                <GradientStop Offset="0.7" Color="#2B3036" />
                                <GradientStop Offset="1.0" Color="#1C1F24" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!--  Brillo de aluminio en el borde superior  -->
                    <Border
                        Height="1"
                        Margin="1,1,1,0"
                        VerticalAlignment="Top"
                        Background="#55FFFFFF"
                        CornerRadius="4,4,0,0" />

                    <!--  Línea indicadora azul horizontal central  -->
                    <Rectangle
                        Height="2"
                        Margin="1,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Fill="#00A2FF" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

</Styles>


