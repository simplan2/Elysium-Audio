<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        =====================================================================
        ESTILOS GLOBALES DE ELYSIUM AUDIO
        Sobrescriben partes del tema Fluent con el look dark profesional.
        =====================================================================
    -->

    <!--  ============================= BUTTON =============================  -->
    <Style Selector="Button">
        <Setter Property="Background" Value="{StaticResource BrushBgElevated}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderDefault}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrushBgPanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}" />
    </Style>

    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrushBorderDefault}" />
    </Style>

    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!--  Variantes de botones: primario y fantasma  -->
    <Style Selector="Button.main">
        <Setter Property="Background" Value="{StaticResource btn_bg_degrade}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBgInput}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextOnAccent}" />
    </Style>
    <!--<Style Selector="Button.main /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrushAccent}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderAccent}" />
    </Style>-->
    <Style Selector="Button.main:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrushAccentHover}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderAccent}" />
    </Style>
    <Style Selector="Button.main:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrushAccentPress}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderAccent}" />
    </Style>

    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderDefault}" />
        <Setter Property="Padding" Value="14,8" />
    </Style>

	<!--  ============================= SCROLLBAR =============================  -->
	<!-- Fondo transparente global para el ScrollBar -->
	<Style Selector="ScrollBar">
		<!-- Ancho del scrollbar cuando está activo -->
		<Setter Property="Width" Value="10" />
		<Setter Property="Background" Value="{StaticResource BrushBgPanel}" />
		<Setter Property="Template">
			<ControlTemplate>
				<Border Background="{TemplateBinding Background}">
					<!-- El Track es obligatorio para que calcule la posición -->
					<Track Name="PART_Track"
                           Minimum="{TemplateBinding Minimum}"
                           Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value}"
                           ViewportSize="{TemplateBinding ViewportSize}"
                           Orientation="{TemplateBinding Orientation}"
                           IsDirectionReversed="True">

						<!-- El Thumb es la barra que se mueve -->
						<Thumb Name="PART_Thumb">
							<Thumb.Template>
								<ControlTemplate>
									<Border Background="#EEF2FE"
                                            CornerRadius="4"
                                            Margin="2"/>
								</ControlTemplate>
							</Thumb.Template>
						</Thumb>

					</Track>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>

	<Style Selector="ScrollBar:pointerover /template/ Border">
		<Setter Property="Background" Value="{StaticResource BrushBgPanel}" />
	</Style>
	<Style Selector="ScrollBar:pressed /template/ Border">
		<Setter Property="Background" Value="{StaticResource BrushBgPanel}" />
	</Style>
	<!-- Efecto al pasar el mouse por encima del Thumb personalizado -->
	<Style Selector="ScrollBar /template/ Thumb:pointerover /template/ Border">
		<Setter Property="Background" Value="#8F9196" />
	</Style>

	<!-- Efecto al hacer clic / presionar el Thumb -->
	<Style Selector="ScrollBar /template/ Thumb:pressed /template/ Border">
		<Setter Property="Background" Value="#9A9BA0" />
	</Style>

	<!--  ============================= SPLITBUTTON =============================  -->
    <!--
        SplitButton de la cola ("Agregar ▾").
        
        La plantilla por defecto de Fluent monta el control como
        Grid > [Button PART_PrimaryButton] [SeparatorBorder] [Button PART_SecondaryButton]
        es decir, SIN Border raíz. Por eso Background, BorderBrush y CornerRadius
        asignados al SplitButton no se pintan nunca: lo que se ve es el tema por
        defecto de los dos botones interiores. Por eso los estados de hover/press
        tampoco se podían alinear con el resto de la familia.
        
        Aquí se sustituye la plantilla completa por una que sí tiene Border raíz
        (PART_RootBorder) y pinta con Binding a las propiedades del propio
        SplitButton, de modo que los tokens del tema mandan de verdad. Se conservan
        los nombres de parte que exige SplitButton (PART_PrimaryButton,
        PART_SecondaryButton, SeparatorBorder) para no romper el clic ni el flyout.
    -->
    <Style Selector="SplitButton.queue">
        <Setter Property="Background" Value="{StaticResource BrushBgPanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Foreground" Value="{StaticResource TextAccentSecondary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMedium}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="14,8,12,8" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="PART_RootBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                    <Grid ColumnDefinitions="*,Auto,Auto">

                        <!--  Mitad principal: dispara el Command del SplitButton.  -->
                        <Button
                            Name="PART_PrimaryButton"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="8,0,0,8"
                            FontSize="{TemplateBinding FontSize}"
                            FontWeight="{TemplateBinding FontWeight}"
                            Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter
                                Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Button>

                        <!--  Separador vertical, con la misma métrica de la familia.  -->
                        <Border
                            Name="SeparatorBorder"
                            Grid.Column="1"
                            Width="0.8"
                            Margin="0,5"
                            Background="Transparent" />

                        <!--  Mitad del desplegable: abre el Flyout.  -->
                        <Button
                            Name="PART_SecondaryButton"
                            Grid.Column="2"
                            Width="28"
                            Padding="0"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
							VerticalAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="0,8,8,0"
                            FontSize="{TemplateBinding FontSize}"
                            Foreground="{TemplateBinding Foreground}">
                          
                            <Path
                                Width="8"
                                Height="4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="M0,0 L4,4 L8,0"
                                Fill="Transparent"
                                Stretch="None"
                                Stroke="{TemplateBinding Foreground}"
                                StrokeJoin="Round"
                                StrokeLineCap="Round"
                                StrokeThickness="1.5" />
                        </Button>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

	<!-- Estilo global para los menús desplegables de las colas -->
	<Style Selector="MenuFlyoutPresenter.queue-flyout">
		<Setter Property="Background" Value="{StaticResource BrushBgOverlay}" />
		<Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="8" />
		<Setter Property="Padding" Value="6" />
	</Style>

	<!-- Estilo opcional para los elementos individuales (MenuItems) dentro del menú -->
	<Style Selector="MenuFlyoutPresenter.queue-flyout MenuItem">
		<Setter Property="CornerRadius" Value="0" />
		<Setter Property="Height" Value="38" />
		<Setter Property="Margin" Value="0,2" />
		<Setter Property="FontSize" Value="{StaticResource FontSizeMD}" />
		<Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
		<Setter Property="Padding" Value="20,8" />
	</Style>
		

	<Style Selector="MenuFlyoutPresenter.queue-flyout MenuItem:pointerover /template/ Border#PART_LayoutRoot">
		<Setter Property="Background" Value="{StaticResource BrushBgElevated}" />
	</Style>
	<Style Selector="MenuFlyoutPresenter.queue-flyout MenuItem:selected /template/ Border#PART_LayoutRoot">
		<Setter Property="Background" Value="{StaticResource BrushAccentDim}" />
	</Style>
	<Style Selector="MenuFlyoutPresenter.queue-flyout MenuItem:selected:pointerover /template/ Border#PART_LayoutRoot">
		<Setter Property="Background" Value="{StaticResource BrushAccentDim}" />
	</Style>


    <!--
        Estados: se cambian las propiedades del propio SplitButton y el
        TemplateBinding las propaga al Border raíz, que ya tiene la transición.
    -->
    <Style Selector="SplitButton.queue:pointerover">
        <Setter Property="Background" Value="{StaticResource BrushBgElevated}" />
		<Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}" />
        <Setter Property="Foreground" Value="{StaticResource TextAccentSecondary}" />
    </Style>

    <Style Selector="SplitButton.queue:pressed">
        <Setter Property="Background" Value="{StaticResource BrushBgPanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}" />
    </Style>

    <!--  Al enfocar la mitad secundaria se resalta el borde del control completo.  -->
    <Style Selector="SplitButton.queue:focus-visible /template/ Border#PART_RootBorder">
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>


    <Style Selector="Button.ghostNoZoom">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderDefault}" />
        <Setter Property="Transitions" Value="{x:Null}" />
    </Style>

    <Style Selector="Button.ghostNoZoom:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrushBgElevated}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}" />
    </Style>


    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrushBgPanelAlt}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}" />
    </Style>

    <!--  Selector segmentado de propósito (Normalize / Analyze)  -->
    <Style Selector="Button.segment">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="14,9" />
    </Style>
    <Style Selector="Button.segment:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrushBgPanelAlt}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.segment.active">
        <Setter Property="Background" Value="{StaticResource bg_degrade}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderAccent}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>
    <Style Selector="Button.segment.active /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource bg_degrade}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderAccent}" />
    </Style>
    <Style Selector="Button.segment.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource bg_degrade}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderAccent}" />
    </Style>

    <!--  Botones stepper estilo plugin VST  -->
    <Style Selector="Button.step">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="38" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{StaticResource BrushBgButton}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderDefault}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeXL}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
    </Style>
    <Style Selector="Button.step:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrushBgElevated}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}" />
    </Style>
    <Style Selector="Button.step:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrushAccentDim}" />
    </Style>
    <Style Selector="Button.step.big">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeDisplay}" />
    </Style>

    <!--  ============================= TEXTBOX =============================  -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{StaticResource BrushBgInput}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderDefault}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="CaretBrush" Value="{StaticResource BrushAccent}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
	<Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
		<Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}" />
	</Style>
	
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
    </Style>
	
    <Style Selector="TextBox:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>
    <!--  TextBox "invisible" dentro de los paneles de parámetros  -->
    <Style Selector="TextBox.param">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="1,0" />
        <Setter Property="TextAlignment" Value="Center" />
	</Style>
	<Style Selector="TextBox.param:focus /template/ TextPresenter">
		<Setter Property="TextBlock.Foreground" Value="{StaticResource BrushTextPrimary}" />
	</Style>
    <!--  ============================= SLIDER =============================  -->

    <!--  Hover  -->
    <!--<Style Selector="Slider.modern-slider:pointerover /template/ Thumb#PART_Thumb">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
    </Style>-->


    <!--  Presionado  -->
    <!--<Style Selector="Slider.modern-slider:pressed /template/ Thumb#PART_Thumb">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
    </Style>-->

    <!--  Color del tramo activo (parte rellenada hasta el thumb)  -->
    <Style Selector="Slider.active-accent /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="{StaticResource BrushAccentSkyblue}" />
    </Style>
    <Style Selector="Slider.active-accent /template/ Thumb">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Background" Value="{StaticResource BrushBgControl}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBgControl}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Slider.active-second /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="{StaticResource BrushAccentSkyblue}" />
    </Style>
    <Style Selector="Slider.active-second /template/ Thumb">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Background" Value="{StaticResource BrushAccentSkyblue}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccentSkyblue}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Slider.active-amber /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="{StaticResource BrushAccentRosa}" />
    </Style>
    <Style Selector="Slider.active-amber /template/ Thumb">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Background" Value="{StaticResource BrushAccentRosa}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccentRosa}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Slider.active-green /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="{StaticResource BrushSuccess}" />
    </Style>
    <Style Selector="Slider.active-green /template/ Thumb">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Background" Value="{StaticResource BrushSuccess}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushSuccess}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!--  ============================= COMBOBOX =============================  -->
    <!--  Selector de presets: fondo oscuro consistente con la paleta  -->
    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{StaticResource BrushBgInput}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderDefault}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="ComboBox:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}" />
    </Style>
    <Style Selector="ComboBox:focus /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeLG}" />
        <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrushBgElevated}" />
    </Style>
    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrushAccentDim}" />
    </Style>
    <Style Selector="ComboBoxItem:selected /template/ TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>

    <!--  ============================= CHECKBOX =============================  -->
    <Style Selector="CheckBox">
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Margin="2" ColumnDefinitions="Auto,Auto">
                    <!--  El cuadro del check  -->
                    <Border
                        x:Name="PART_Box"
                        Width="16"
                        Height="16"
                        Background="Transparent"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1.4"
                        CornerRadius="{StaticResource RadiusSM}"
                        DockPanel.Dock="Left">
                        <Viewbox
                            Width="11"
                            Height="11"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <!--  La marca de verificación  -->
                            <Path
                                x:Name="PART_CheckMark"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="M 2,8 L 6,12 L 14,3"
                                IsVisible="False"
                                Stroke="White"
                                StrokeLineCap="Round"
                                StrokeThickness="2" />
                        </Viewbox>

                    </Border>

                    <!--  EL CONTENIDO (texto)  -->
                    <ContentPresenter
                        Grid.Column="1"
                        Margin="7,0,0,0"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding Content}"
                        Foreground="{TemplateBinding Foreground}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="CheckBox:pointerover /template/ Border#PART_Box">
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}" />
    </Style>

    <Style Selector="CheckBox:checked /template/ Border#PART_Box">
        <Setter Property="Background" Value="{StaticResource BrushAccentDim}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
    </Style>

    <Style Selector="CheckBox:checked:pointerover /template/ Border#PART_Box">
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccentHover}" />
    </Style>

    <Style Selector="CheckBox:checked /template/ Path#PART_CheckMark">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="CheckBox:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!--  Barra de estado: verde "success" solo cuando el lote se completó sin errores  -->
    <Style Selector="Border.ok > Ellipse">
        <Setter Property="Fill" Value="{StaticResource BrushSuccess}" />
    </Style>
    <Style Selector="Border.ok TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
    </Style>

    <!--  ============================= TOGGLESWITCH =============================  -->
    <Style Selector="ToggleSwitch">
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
    </Style>

    <!--  ============================= DATAGRID =============================  -->
    <Style Selector="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeLG}" />
    </Style>

    <Style Selector="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource BrushBgPanelAlt}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMD}" />
    </Style>

    <!--
        Las cabeceras son el unico sitio donde una traduccion larga puede no caber: las
        celdas ya traian TextTrimming propio. Con columnas Width="*" solo se recorta si
        la ventana esta en su MinWidth, pero cuando ocurre se cortaba a pelo y se
        derramaba sobre la columna vecina. Con puntos suspensivos al menos se degrada
        limpio, y el ToolTip deja el texto completo disponible.
    -->
    <Style Selector="DataGridColumnHeader TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="ToolTip.Tip">
            <Setter.Value>
                <Binding Path="Text" RelativeSource="{RelativeSource Self}" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="DataGridCell">
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  ============================= ListBox Popup =============================  -->
    <Style Selector="ListBox.dark-popup">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style Selector="ListBox.dark-popup ListBoxItem">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter
                        Margin="{TemplateBinding Padding}"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Height" Value="38" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="ListBox.dark-popup ListBoxItem:pointerover">
        <Setter Property="Background" Value="{StaticResource BrushBgElevated}" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="ListBox.dark-popup ListBoxItem:selected">
        <Setter Property="Background" Value="{StaticResource BrushAccentDim}" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="ListBox.dark-popup ListBoxItem:selected:pointerover">
        <Setter Property="Background" Value="{StaticResource BrushAccentDim}" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="FlyoutPresenter">
        <Setter Property="Background" Value="{StaticResource BrushBgOverlay}" />
        <Setter Property="Padding" Value="0,6" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}" />
    </Style>
</Styles>


